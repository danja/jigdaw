# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# web/app.bundle.js is generated by `npm run build:web` but IS committed on
# purpose: the server runs it without a build step, and the repository is the
# delivery mechanism. Regenerate and commit it whenever web/ or src/ changes.

# The published documentation site, built from docs/*.md by
# bin/build-docs-site.js and deployed by .github/workflows/docs.yml. Built
# fresh on every push; there is nothing here that needs to be readable
# without running the build.
docs-site/

# Build output for the native adapter (native/install.sh). A wildcard rather
# than the exact name: native/build-default/ and native/build-juce/, two
# scratch configurations tried once, reached origin/main in commit
# 673a95c ("JUCE-based wrapper") because neither matched this pattern. See
# MISTAKES.md.
native/build*/

# Signing keys. bin/keys.js refuses to write one inside a git working tree, so
# this should never match anything. It is here as the second lock: a key is the
# one thing in this repository that would be an incident rather than a bug, and
# a scanner cannot tell an invented fixture from a live credential.
*.pkcs8
jigdaw-key*.json
**/keys/*.json

# Generated by bin/wam.js: WAM packaging, rebuilt from the profile on demand.
plugins/*/wam/

# Object files and the linker symlink from plugins/8b8/build.sh. The wasm it
# produces is copied up to plugins/8b8/8b8.wasm and committed, like every
# other plugin's; nothing here is an input to anything.
plugins/8b8/build/

# The probe container: built from ~/wam-examples by hand, not ours to commit.
web/foreign/*.wam
web/foreign/wam-host.js
web/wam-demo/
