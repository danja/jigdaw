    jig:clip <#clip-11> , <#clip-12> , <#clip-13> , <#clip-14> , <#clip-15> , <#clip-16> .

<#track-4>
    a jig:Track ;
    rdfs:label "Pluck" ;
    jig:gain 0.6 ;
    jig:pan -0.3 ;
    jig:midiInput <#node-4> ;
    jig:clip <#clip-17> , <#clip-18> , <#clip-19> , <#clip-20> .

<#track-5>
    a jig:Track ;
    rdfs:label "Bells and lead" ;
    jig:gain 0.5 ;
    jig:pan 0.25 ;
    jig:midiInput <#node-5> ;
    jig:clip <#clip-21> , <#clip-22> , <#clip-23> , <#clip-24> , <#clip-25> .

<#track-6>
    a jig:Track ;
    rdfs:label "Chip" ;
    jig:gain 2.0 ;
    jig:pan 0.45 ;
    jig:midiInput <#node-6> ;
    jig:clip <#clip-26> , <#clip-27> .

<#track-7>
    a jig:Track ;
    rdfs:label "Reverb return" ;
    jig:gain 1.5 ;
    jig:audioInput <#node-7> .

