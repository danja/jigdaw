<#envelope-7-p0> a jig:EnvelopePoint ; jig:atBeat 0.0 ; jig:pointValue 1.0 ; jig:curve jig:Step .
<#envelope-7-p1> a jig:EnvelopePoint ; jig:atBeat 152.0 ; jig:pointValue 1.0 ; jig:curve jig:Smooth .
<#envelope-7-p2> a jig:EnvelopePoint ; jig:atBeat 160.0 ; jig:pointValue 0.0 ; jig:curve jig:Linear .

<#transport>
    a jig:Transport ;
    jig:beatsPerBar 4 ; jig:beatUnit 4 ;
    jig:loopEnabled false ;
    jig:tempoPoint <#t0> .
<#t0> a jig:TempoPoint ; jig:atBeat 0.0 ; jig:bpm 104.0 .
