    jig:transport <#transport> .

<#track-1>
    a jig:Track ;
    rdfs:label "Drums" ;
    jig:gain 0.42 ;
    jig:midiInput <#node-1> ;
    jig:clip <#clip-1> , <#clip-2> , <#clip-3> , <#clip-4> , <#clip-5> .

<#track-2>
    a jig:Track ;
    rdfs:label "Bass" ;
    jig:gain 0.5 ;
    jig:midiInput <#node-2> ;
    jig:clip <#clip-10> , <#clip-6> , <#clip-7> , <#clip-8> , <#clip-9> .

<#track-3>
    a jig:Track ;
    rdfs:label "Pad" ;
