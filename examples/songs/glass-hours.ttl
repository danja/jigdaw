<>
    a jig:Project ;
    rdfs:label "Glass Hours" ;
    jig:revision 74 ;
    jig:track <#track-1> , <#track-2> , <#track-3> , <#track-4> , <#track-5> , <#track-6> , <#track-7> ;
    jig:node <#node-1> , <#node-2> , <#node-3> , <#node-4> , <#node-5> , <#node-6> , <#node-7> , <#node-8> ;
