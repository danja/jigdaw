# examples/session-project.ttl
#
# A worked JigDAW project. Two tracks: one holding two plugins wired in series,
# with parameters set and a MIDI clip playing into the first, and one holding
# only an audio clip. And a tempo map.
#
# Note what is not here. There is no rdf:List and no ordering property. The order
# the plugins process in is derived from the connections, exactly as Web Audio
# derives it, so declaring it would be a second answer to a question the graph
# already answers. The tempo map is ordered by the beat each point takes effect
# at, which survives an insertion in the middle and is selectable in one triple
# pattern.
#
# Editor metadata lives in a separate graph, not in this file, so that dragging a
# node on screen cannot invalidate a compiled audio graph.

@base <https://example.org/sessions/first/> .

@prefix jig:     <http://purl.org/stuff/jigdaw/> .
@prefix trn:     <http://purl.org/stuff/transmissions/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<>
    a jig:Project ;
    rdfs:label "First" ;
    dcterms:created "2026-09-16T19:00:00Z"^^xsd:dateTime ;
    jig:revision 7 ;
    jig:track <#track-1> , <#track-2> ;
    jig:node <#pad> , <#verb> ;
    jig:connection <#c1> , <#c2> ;
    jig:transport <#transport> .

## Tracks. A track is a mixer strip and a line of the arrangement. Its nodes say
## they are on it, rather than the track listing them, so moving a node between
## tracks is one triple.

<#track-1>
    a jig:Track ;
    rdfs:label "Pad" ;
    jig:gain 0.8 ; jig:pan -0.25 ;
    jig:midiInput <#pad> ;
    jig:clip <#clip-1> .

## A track with no nodes. Its audio clips go straight to its fader.

<#track-2>
    a jig:Track ;
    rdfs:label "Loop" ;
    jig:muted true ;
    jig:clip <#clip-2> .

## Clips. Placement is in beats of the transport. A note's start is relative to
## its clip, so moving the clip moves the notes without touching them.

<#clip-1>
    a jig:MidiClip ;
    trn:startBeat 0.0 ; trn:lengthBeats 8.0 ;
    jig:note <#clip-1-n1> , <#clip-1-n2> .

<#clip-1-n1> a jig:Note ; trn:startBeat 0.0 ; trn:lengthBeats 2.0 ; trn:pitch 57 ; trn:velocity 96 .
<#clip-1-n2> a jig:Note ; trn:startBeat 4.0 ; trn:lengthBeats 2.0 ; trn:pitch 60 ; trn:velocity 80 .

## The audio is referred to, never embedded. A relative source resolves against
## this document, so a session saved beside its media folder stays portable.

<#clip-2>
    a jig:AudioClip ;
    trn:startBeat 16.0 ; trn:lengthBeats 8.0 ;
    jig:source <media/loop.wav> ;
    jig:offsetSeconds 0.5 .

## Nodes. A node is an instance, not a plugin: two instances of one plugin are
## two nodes with the same jig:plugin and different settings.

<#pad>
    a jig:Node ;
    rdfs:label "Pad" ;
    jig:onTrack <#track-1> ;
    jig:plugin <https://example.org/plugins/driftgate/> ;
    jig:setting <#pad-drive> .

<#verb>
    a jig:Node ;
    rdfs:label "Verb" ;
    jig:onTrack <#track-1> ;
    jig:plugin <https://example.org/plugins/cascade/> ;
    jig:setting <#verb-mix> , <#verb-size> ;
    # Opaque to the host. Parameter values are settings, not state, and storing
    # them in both places means the two disagree on restore.
    jig:nodeState "eyJtb2RlIjoicGxhdGUiLCJzZWVkIjo0MTF9" .

<#pad-drive>  a jig:ParameterSetting ; jig:symbol "drive" ; jig:value 0.62 .
<#verb-mix>   a jig:ParameterSetting ; jig:symbol "mix"   ; jig:value 0.34 .
<#verb-size>  a jig:ParameterSetting ; jig:symbol "size"  ; jig:value 31.0 .

## Connections. Explicit, directed, with named endpoints.

<#c1>
    a jig:Connection ;
    jig:from <#c1-from> ; jig:to <#c1-to> ;
    jig:signalKind trn:Audio .

<#c1-from> a jig:Endpoint ; jig:endpointNode <#pad>  ; jig:portIndex 0 .
<#c1-to>   a jig:Endpoint ; jig:endpointNode <#verb> ; jig:portIndex 0 .

## A connection to a parameter names it by symbol rather than by index. An
## endpoint gives one or the other and never both.

<#c2>
    a jig:Connection ;
    jig:from <#c2-from> ; jig:to <#c2-to> ;
    jig:signalKind trn:Audio .

<#c2-from> a jig:Endpoint ; jig:endpointNode <#pad>  ; jig:portIndex 0 .
<#c2-to>   a jig:Endpoint ; jig:endpointNode <#verb> ; jig:portSymbol "mix" .

## Transport. The tempo map is keyed by beat.

<#transport>
    a jig:Transport ;
    jig:beatsPerBar 4 ; jig:beatUnit 4 ;
    jig:loopStart 0.0 ; jig:loopEnd 32.0 ; jig:loopEnabled true ;
    jig:tempoPoint <#t0> , <#t1> .

<#t0> a jig:TempoPoint ; jig:atBeat 0.0  ; jig:bpm 96.0 .
<#t1> a jig:TempoPoint ; jig:atBeat 16.0 ; jig:bpm 104.0 .
