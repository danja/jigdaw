# examples/counterexample-project.ttl
#
# A deliberately broken project. This file MUST NOT validate against
# vocabs/shapes.ttl. It exists so the project shapes are known to fire.
#
# Each defect is marked with the constraint that should catch it.

@base <https://example.org/sessions/broken/> .

@prefix jig:  <http://purl.org/stuff/jigdaw/> .
@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<>
    a jig:Project ;
    rdfs:label "Broken" ;
    # No jig:revision, so no changeset can be checked against it.
    jig:node <#a> , <#b> ;
    jig:track <#track> ;
    jig:connection <#c> ;
    jig:master <#master> , <#master2> ;
    jig:transport <#transport> .

<#a>
    a jig:Node ;
    # Plugin named by a relative reference that resolves to a non-https IRI, so
    # the project cannot be reopened anywhere else.
    jig:plugin <file:///home/danny/plugins/local.wasm> .
    # On no track, so nothing says where its sound goes.

# On two tracks, so its sound would be summed twice.
<#b>
    a jig:Node ;
    jig:onTrack <#track> , <#other-track> ;
    jig:plugin <https://example.org/plugins/pulse/> .

<#other-track> a jig:Track .

<#track>
    a jig:Track ;
    # An inverted fader, and a pan past the right-hand end.
    jig:gain -0.5 ;
    jig:pan 1.5 ;
    # MIDI clips played into something that is not a node.
    jig:midiInput <#track> ;
    # Audio clips played into two nodes at once.
    jig:audioInput <#a> , <#b> ;
    jig:clip <#midi-clip> , <#audio-clip> .

# Starts before the transport does, has no length, and holds a node as a note.
<#midi-clip>
    a jig:MidiClip ;
    trn:startBeat -4.0 ;
    jig:note <#note> , <#a> .

# Plays no file, from before the start of the file it does not play.
<#audio-clip>
    a jig:AudioClip ;
    trn:startBeat 0.0 ; trn:lengthBeats 4.0 ;
    jig:offsetSeconds -1.0 ;
    # A fade that lasts less than no time, and another the wrong way round.
    jig:fadeInBeats -2.0 ; jig:fadeOutBeats -0.5 ;
    # Neither true nor false.
    jig:muted "maybe" ;
    # Not a boolean either.
    jig:locked 1 .

# Starts before its clip, lasts no time, has a pitch MIDI cannot send, and a
# velocity MIDI reads as a note off.
<#note>
    a jig:Note ;
    trn:startBeat -1.0 ;
    trn:lengthBeats 0.0 ;
    trn:pitch 128 ;
    trn:velocity 0 .

<#c>
    a jig:Connection ;
    jig:from <#c-from> ; jig:to <#c-to> .
    # No jig:signalKind, so nothing knows whether this is an audio edge or
    # host-routed MIDI.

# Names its port twice, two different ways. Nothing downstream can resolve which
# was meant.
<#c-from>
    a jig:Endpoint ;
    jig:endpointNode <#a> ;
    jig:portIndex 0 ;
    jig:portSymbol "mix" .

# Names no port at all.
<#c-to>
    a jig:Endpoint ;
    jig:endpointNode <#a> .

# Symbol is not usable as an identifier, and there is no value.
<#bad-setting>
    a jig:ParameterSetting ;
    jig:symbol "cutoff (hz)" .

<#transport>
    a jig:Transport ;
    # A bar of no beats, and a loop that ends before it starts.
    jig:beatsPerBar 0 ;
    jig:loopStart 32.0 ;
    jig:loopEnd 8.0 ;
    jig:tempoPoint <#t0> .

# A stopped clock.
<#t0> a jig:TempoPoint ; jig:atBeat 0.0 ; jig:bpm 0.0 .

# The track view. Each is a violation of one constraint above.

# A second master, gain below zero and pan beyond the edge.
<#master> a jig:Master ; jig:gain -1.0 ; jig:pan 2.0 .
<#master2> a jig:Master .

# A send back to its own track, at a negative level, tapped nowhere in particular.
<#send-1> a jig:Send ;
    jig:sendFrom <#track> ; jig:sendTo <#track> ;
    jig:level -0.5 ; jig:tap <https://example.org/nowhere> .

# A marker before the start.
<#marker-1> a jig:Marker ; jig:atBeat -2.0 .

# A region that lasts no time.
<#region-1> a jig:Region ; trn:startBeat 4.0 ; trn:lengthBeats 0.0 .

# A signature change at beat zero, in a bar of no beats.
<#s0> a jig:SignaturePoint ; jig:atBeat 0.0 ; jig:beatsPerBar 0 ; jig:beatUnit 4 .

# Targets a node and a project-level kind at once.
<#envelope-1> a jig:Envelope ;
    jig:targetNode <#a> ; jig:targetSymbol "cutoff" ;
    jig:targetKind jig:Tempo .

# A point with no value and an unknown curve.
<#point-1> a jig:EnvelopePoint ; jig:atBeat -1.0 ; jig:curve <https://example.org/wobbly> .
