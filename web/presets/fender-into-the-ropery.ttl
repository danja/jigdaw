# web/presets/fender-into-the-ropery.ttl
#
# GENERATED: the two jig:nodeState literals are the files each Ferrite has
# loaded, encoded as src/host/StateCodec.js encodes a saved session. Relative
# IRIs and no @base, for the reason web/presets/amp-into-room.ttl gives.
#
# The amp is a Neural Amp Modeler capture of a 1965 Fender Super Reverb at the
# edge of breakup, "FNDR BFSR VB Edge WRM2 CAB FREE", modelled by amalgamaudio
# and trained with TONE3000, per the file's own metadata. It includes the
# cabinet, so the first Ferrite's impulse response is a single sample and
# changes nothing. The room is the Ropery recording, ST450 stereo, "BURST",
# from the Sonic Palimpsest impulse response library, played through the
# second Ferrite with its amp switched off.

@prefix jig:  <http://purl.org/stuff/jigdaw/> .
@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<>
    a jig:Project ;
    rdfs:label "Fender into the Ropery" ;
    jig:revision 1 ;
    jig:track <#track-1> ;
    jig:node <#amp> , <#room> ;
    jig:connection <#c1> ;
    jig:transport <#transport> .

<#track-1>
    a jig:Track ;
    rdfs:label "Fender into the Ropery" .

<#amp>
    a jig:Node ;
    jig:onTrack <#track-1> ;
    rdfs:label "Fender Super Reverb" ;
    jig:plugin <../plugins/ferrite/> ;
    jig:setting <#amp-output> ;
    jig:nodeState "{\"nam\":{\"__jigdawArrayBuffer\":\"\"},\"ir\":{\"__jigdawArrayBuffer\":\"UklGRigAAABXQVZFZm10IBAAAAADAAEAgLsAAADuAgAEACAAZGF0YQQAAAAAAIA/\"}}" .

<#room>
    a jig:Node ;
    jig:onTrack <#track-1> ;
    rdfs:label "Ropery" ;
    jig:plugin <../plugins/ferrite/> ;
    jig:setting <#room-amp> , <#room-mix> ;
    jig:nodeState "{\"ir\":{\"__jigdawArrayBuffer\":\"\"}}" .

<#amp-output> a jig:ParameterSetting ; jig:symbol "output" ; jig:value 0.6 .
<#room-amp>   a jig:ParameterSetting ; jig:symbol "amp"    ; jig:value 0.0 .
<#room-mix>   a jig:ParameterSetting ; jig:symbol "mix"    ; jig:value 0.35 .

<#c1>
    a jig:Connection ;
    jig:from <#c1-from> ; jig:to <#c1-to> ;
    jig:signalKind trn:Audio .

<#c1-from> a jig:Endpoint ; jig:endpointNode <#amp>  ; jig:portIndex 0 .
<#c1-to>   a jig:Endpoint ; jig:endpointNode <#room> ; jig:portIndex 0 .

<#transport>
    a jig:Transport ;
    jig:beatsPerBar 4 ; jig:beatUnit 4 ;
    jig:tempoPoint <#t0> .

<#t0> a jig:TempoPoint ; jig:atBeat 0.0 ; jig:bpm 120.0 .
