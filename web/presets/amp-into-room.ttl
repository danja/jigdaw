# web/presets/amp-into-room.ttl
#
# A bundled preset: an ordinary project, docs/project-format.md, with no @base.
# Every IRI in it is relative, so it resolves against wherever it was fetched
# from and loads the plugins served beside it, on a local dev server and on the
# deployment alike. tests/ui/Presets.test.js opens it for real.

@prefix jig:  <http://purl.org/stuff/jigdaw/> .
@prefix trn:  <http://purl.org/stuff/transmissions/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<>
    a jig:Project ;
    rdfs:label "Amp into a room" ;
    jig:revision 1 ;
    jig:track <#track-1> ;
    jig:node <#lead> , <#guitar> , <#amp> , <#room> ;
    jig:connection <#c1> , <#c2> , <#c3> ;
    jig:transport <#transport> .

<#track-1>
    a jig:Track ;
    rdfs:label "Amp into a room" .

<#lead>
    a jig:Node ;
    jig:onTrack <#track-1> ;
    rdfs:label "Riff" ;
    jig:plugin <../plugins/melgen/> ;
    jig:setting <#lead-root> , <#lead-scale> , <#lead-length> , <#lead-phrase> , <#lead-grid> , <#lead-density> , <#lead-register> , <#lead-seed> .

<#guitar>
    a jig:Node ;
    jig:onTrack <#track-1> ;
    rdfs:label "Guitar" ;
    jig:plugin <../plugins/mop/> ;
    jig:setting <#guitar-program> .

<#lead-root>     a jig:ParameterSetting ; jig:symbol "root_note"    ; jig:value 52.0 .
<#lead-scale>    a jig:ParameterSetting ; jig:symbol "scale"        ; jig:value 2.0 .
<#lead-length>   a jig:ParameterSetting ; jig:symbol "length_beats" ; jig:value 16.0 .
<#lead-phrase>   a jig:ParameterSetting ; jig:symbol "phrase_bars"  ; jig:value 2.0 .
<#lead-grid>     a jig:ParameterSetting ; jig:symbol "subdivision"  ; jig:value 0.0 .
<#lead-density>  a jig:ParameterSetting ; jig:symbol "density"      ; jig:value 0.5 .
<#lead-register> a jig:ParameterSetting ; jig:symbol "register"     ; jig:value 1.0 .
<#lead-seed>     a jig:ParameterSetting ; jig:symbol "seed"         ; jig:value 3.0 .
<#guitar-program> a jig:ParameterSetting ; jig:symbol "program" ; jig:value 27.0 .

<#amp>
    a jig:Node ;
    jig:onTrack <#track-1> ;
    rdfs:label "Amp" ;
    jig:plugin <../plugins/ferrite/> ;
    jig:setting <#amp-input> , <#amp-output> .

<#room>
    a jig:Node ;
    jig:onTrack <#track-1> ;
    rdfs:label "Room" ;
    jig:plugin <../plugins/cascade/> ;
    jig:setting <#room-mode> , <#room-mix> , <#room-size> .

<#amp-input>  a jig:ParameterSetting ; jig:symbol "input"  ; jig:value 3.5 .
<#amp-output> a jig:ParameterSetting ; jig:symbol "output" ; jig:value 1.6 .
<#room-mode>  a jig:ParameterSetting ; jig:symbol "mode"   ; jig:value 1.0 .
<#room-mix>   a jig:ParameterSetting ; jig:symbol "mix"    ; jig:value 0.25 .
<#room-size>  a jig:ParameterSetting ; jig:symbol "size"   ; jig:value 30.0 .

<#c1>
    a jig:Connection ;
    jig:from <#c1-from> ; jig:to <#c1-to> ;
    jig:signalKind trn:Audio .

<#c1-from> a jig:Endpoint ; jig:endpointNode <#amp>  ; jig:portIndex 0 .
<#c1-to>   a jig:Endpoint ; jig:endpointNode <#room> ; jig:portIndex 0 .

<#c2>
    a jig:Connection ;
    jig:from <#c2-from> ; jig:to <#c2-to> ;
    jig:signalKind trn:Midi .

<#c2-from> a jig:Endpoint ; jig:endpointNode <#lead>   ; jig:portIndex 0 .
<#c2-to>   a jig:Endpoint ; jig:endpointNode <#guitar> ; jig:portIndex 0 .

<#c3>
    a jig:Connection ;
    jig:from <#c3-from> ; jig:to <#c3-to> ;
    jig:signalKind trn:Audio .

<#c3-from> a jig:Endpoint ; jig:endpointNode <#guitar> ; jig:portIndex 0 .
<#c3-to>   a jig:Endpoint ; jig:endpointNode <#amp>    ; jig:portIndex 0 .

<#transport>
    a jig:Transport ;
    jig:beatsPerBar 4 ; jig:beatUnit 4 ;
    jig:tempoPoint <#t0> .

<#t0> a jig:TempoPoint ; jig:atBeat 0.0 ; jig:bpm 120.0 .
