{
  "name": "jigdaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "A web-native digital audio workstation and plugin format",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "test": "node bin/check-suites.js && vitest run",
    "validate": "node bin/validate.js",
    "check-suites": "node bin/check-suites.js",
    "build:web": "node bin/build-web.js",
    "serve": "node bin/serve.js",
    "build:vocab": "node bin/build-vocab-site.js",
    "build:docs": "node bin/build-docs-site.js",
    "build:index": "node bin/build-plugin-index.js",
    "bundle": "node bin/bundle.js",
    "wam": "node bin/wam.js",
    "wam:fixtures": "node bin/wam-fixtures.js",
    "build": "npm run build:index && npm run build:vocab && npm run build:web"
  },
  "dependencies": {
    "@rdfjs/parser-n3": "^2.2.0",
    "@zazuko/env": "^3.0.1",
    "rdf-validate-shacl": "^0.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "marked": "^18.0.13",
    "vitest": "^3.0.0"
  }
}
