{
  "iri": "https://strandz.it/jigdaw/plugins/sam/",
  "label": "Sam",
  "comment": "Software Automatic Mouth, the 1982 Commodore 64 formant speech synthesiser, as an instrument: typed text is spoken either one word per MIDI note, sung at the pitch of the key, or one word per step from a start bar, locked to the host transport.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "sam",
  "roles": [
    "trn:Instrument",
    "trn:AudioInstrument"
  ],
  "accepts": [
    "trn:Midi"
  ],
  "produces": [
    "trn:Audio"
  ],
  "genres": [
    "Chiptune",
    "Experimental",
    "Vocal"
  ],
  "cautions": [
    "Transport mode is silent while the host is stopped (use Speak to audition) and when the host gives no beat position. Keys mode ignores the transport.",
    "The words are a jig:asset the person replaces with a plain text file of their own, up to 2000 printable ASCII characters and 512 words, and are saved with the session. A lone _ is a rest. Phonetic reads SAM phoneme codes, e.g. /HEH3LOW2 WER4LD.",
    "SAM's code is vendored in third_party/ and has no licence (abandonware; see third_party/SAM-LICENSE.md). Whether it may be redistributed with this plugin is the repository owner's decision, recorded in HUMANS.md.",
    "Ported from the Downspout VST3 of the same name. Not carried over: the six voice presets (set Speed, Pitch, Throat and Mouth by hand) and the Current Word read-out."
  ],
  "format": "trn:Jig",
  "abi": "jig:Abi2",
  "requires": [
    "jig:MidiEvents",
    "trn:HostTransport"
  ],
  "prefers": [],
  "shape": {
    "audioInputs": 0,
    "audioOutputs": 1,
    "outputChannels": 2,
    "renderQuantum": 128,
    "latencyFrames": 0,
    "tailFrames": 48000
  },
  "resources": {
    "module": "sam.wasm",
    "processor": "sam-processor.js"
  },
  "assets": [
    {
      "key": "text",
      "file": "text.txt",
      "mediaType": "text/plain",
      "userReplaceable": true,
      "maxBytes": 2000
    }
  ],
  "ports": [
    {
      "symbol": "mode",
      "name": "Mode",
      "default": 0,
      "minimum": 0,
      "maximum": 1,
      "group": "Source",
      "scalePoints": [
        {
          "label": "Keys",
          "value": 0
        },
        {
          "label": "Transport",
          "value": 1
        }
      ],
      "paramIndex": 0
    },
    {
      "symbol": "speed",
      "name": "Speed",
      "default": 72,
      "minimum": 20,
      "maximum": 200,
      "group": "Voice",
      "paramIndex": 1
    },
    {
      "symbol": "pitch",
      "name": "Pitch",
      "default": 64,
      "minimum": 16,
      "maximum": 255,
      "group": "Voice",
      "paramIndex": 2
    },
    {
      "symbol": "mouth",
      "name": "Mouth",
      "default": 128,
      "minimum": 0,
      "maximum": 255,
      "group": "Voice",
      "paramIndex": 3
    },
    {
      "symbol": "throat",
      "name": "Throat",
      "default": 128,
      "minimum": 0,
      "maximum": 255,
      "group": "Voice",
      "paramIndex": 4
    },
    {
      "symbol": "monotone",
      "name": "Monotone",
      "default": 0,
      "minimum": 0,
      "maximum": 1,
      "group": "Voice",
      "toggled": true,
