    lv2:symbol "pitch" ; lv2:name "Pitch" ;
    lv2:default 64 ; lv2:minimum 16 ; lv2:maximum 255 ;
    jig:paramIndex 2 ;
    jig:controlGroup "Voice" .

<#mouth>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mouth" ; lv2:name "Mouth" ;
    lv2:default 128 ; lv2:minimum 0 ; lv2:maximum 255 ;
    jig:paramIndex 3 ;
    jig:controlGroup "Voice" .

<#throat>
