# sam/profile.ttl
#
# GENERATED by bin/write-profile.js. Do not edit: the digests are of the
# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/sam/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Sam" ;
    rdfs:comment "Software Automatic Mouth, the 1982 Commodore 64 formant speech synthesiser, as an instrument: typed text is spoken either one word per MIDI note, sung at the pitch of the key, or one word per step from a start bar, locked to the host transport." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:Instrument , trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Chiptune" , "Experimental" , "Vocal" ;
    trn:caution "Transport mode is silent while the host is stopped (use Speak to audition) and when the host gives no beat position. Keys mode ignores the transport." ;
    trn:caution "The words are a jig:asset the person replaces with a plain text file of their own, up to 2000 printable ASCII characters and 512 words, and are saved with the session. A lone _ is a rest. Phonetic reads SAM phoneme codes, e.g. /HEH3LOW2 WER4LD." ;
    trn:caution "SAM's code is vendored in third_party/ and has no licence (abandonware; see third_party/SAM-LICENSE.md). Whether it may be redistributed with this plugin is the repository owner's decision, recorded in HUMANS.md." ;
    trn:caution "Ported from the Downspout VST3 of the same name. Not carried over: the six voice presets (set Speed, Pitch, Throat and Mouth by hand) and the Current Word read-out." ;
    trn:format trn:Jig ;
    trn:requires jig:MidiEvents ;
    trn:requires trn:HostTransport ;

    jig:audioInputs 0 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:tailFrames 48000 ;

    jig:module <#module> ;
    jig:processor <#processor> ;
    jig:asset <#text> ;

    lv2:port <#mode> , <#speed> , <#pitch> , <#mouth> , <#throat> , <#monotone> , <#phonetic> , <#midi_ch> , <#advance> , <#transpose> , <#release> , <#step> , <#start_bar> , <#loop> , <#speak> , <#tone> , <#level> .

<#module>
    a jig:Module ;
    jig:location <sam.wasm> ;
    jig:mediaType "application/wasm" ;
    jig:abi jig:Abi2 ;
    jig:integrity "sha384-41T0Z1ePoDBrebJXRi0cdO5QfEh8JdKuDV9KMn7phH+sftP8yfi0D1KKun0M56iG" .

<#processor>
    a jig:Processor ;
    jig:location <sam-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "sam" ;
    jig:integrity "sha384-4WMudQYak1/2ByYe948/rBicToEyKEWlYsxMND0FMTmgYWp6vskPkSQe35/MTj7z" .

<#text>
    a jig:Resource ;
    jig:location <text.txt> ;
    jig:mediaType "text/plain" ;
    jig:userReplaceable true ;
    jig:maxBytes 2000 ;
    jig:integrity "sha384-XxknJfigrQ7OsZYyMCE7QAwWxLdsmLUHDXbB973KGYNMAuBq434z2mfwadXC6bqt" .

<#mode>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mode" ; lv2:name "Mode" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 0 ;
    jig:controlGroup "Source" ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#mode-0> ,
        <#mode-1> .

<#mode-0> rdfs:label "Keys" ; rdf:value 0 .

<#mode-1> rdfs:label "Transport" ; rdf:value 1 .

<#speed>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "speed" ; lv2:name "Speed" ;
    lv2:default 72 ; lv2:minimum 20 ; lv2:maximum 200 ;
    jig:paramIndex 1 ;
    jig:controlGroup "Voice" .

<#pitch>
