@base <https://strandz.it/jigdaw/plugins/boost/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Boost" ;
    rdfs:comment "A gain stage in C++, the minimal starting point for a WebAssembly JigDAW plugin: everything in boost.cpp beyond jig_process is ABI wiring, meant to be copied." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect , trn:Utility ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#gain> .

<#module>
    a jig:Module ;
    jig:location <boost.wasm> ;
    jig:mediaType "application/wasm" ;
    jig:abi jig:Abi1 ;
    jig:integrity "sha384-wuvO7yOa8fv0ESRAnUc+PGs6Cn4DNbbIuB4BKmqOoyi5+do7vdD+k1QdmOJbnk0G" .

<#processor>
    a jig:Processor ;
    jig:location <boost-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "boost" ;
    jig:integrity "sha384-LvUPMRDEsrRfseZIbc3H//8TQbWuvXaVFSVguK998GTpbBs+vFsaIe4hWcDSWoHO" .

<#gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "gain" ; lv2:name "Gain" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
    jig:paramIndex 0 .
