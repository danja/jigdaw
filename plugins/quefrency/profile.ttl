    lv2:scalePoint
        <#estimator-0> ,
        <#estimator-1> ;
    midi:binding <#estimator-cc> .

<#estimator-0> rdfs:label "Cepstral" ; rdf:value 0 .

<#estimator-1> rdfs:label "True envelope" ; rdf:value 1 .

<#estimator-cc> a midi:Controller ; midi:controllerNumber 78 .

<#mix>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mix" ; lv2:name "Mix" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 9 ;
    midi:binding <#mix-cc> .

<#mix-cc> a midi:Controller ; midi:controllerNumber 79 .

<#output>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "output" ; lv2:name "Output" ;
    lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 12 ;
    jig:paramIndex 10 ;
    units:unit units:db ;
    midi:binding <#output-cc> .

<#output-cc> a midi:Controller ; midi:controllerNumber 80 .
