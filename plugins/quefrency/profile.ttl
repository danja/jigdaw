    units:unit units:pc ;
    midi:binding <#harmonic_depth-cc> .

<#harmonic_depth-cc> a midi:Controller ; midi:controllerNumber 76 .

<#lifter>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "lifter" ; lv2:name "Lifter" ;
    lv2:default 1.5 ; lv2:minimum 0.5 ; lv2:maximum 5 ;
    jig:paramIndex 7 ;
    units:unit units:ms ;
    midi:binding <#lifter-cc> .

<#lifter-cc> a midi:Controller ; midi:controllerNumber 77 .

<#estimator>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "estimator" ; lv2:name "Envelope estimator" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 8 ;
