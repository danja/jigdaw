    jig:location <quefrency.wasm> ;
    jig:mediaType "application/wasm" ;
    jig:abi jig:Abi1 ;
    jig:integrity "sha384-gTUvJvcxwp5rQoaOSgY516YFpZ+3ILG1otfNh7/rUmaWRD7M5WM4ot/CzzYNzqf1" .

<#processor>
