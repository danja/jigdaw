# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/quefrency/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Quefrency" ;
    rdfs:comment "Separates its input through the cepstrum into a formant envelope and a harmonic structure, shifts and reshapes each independently, and multiplies them back together." ;
    trn:vendor "danja" ;
    doap:revision "0.2.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio , trn:ControlMidi ;
    trn:produces trn:Audio ;
    trn:genre "Electronic" , "Experimental" ;
    trn:caution "Latency is 2047 frames at 50 kHz and below, and 4095 above. The processor reports the figure for the actual rate; the module ABI carries no latency, so a native host is not told it and will not compensate." ;
    trn:caution "The formant envelope of a chord is the envelope of the whole mixture. Pitch shift moves every spectral peak, so chords stay chords, but it cannot act on one note of a chord alone." ;
    trn:caution "Transients smear when pitch or frequency shift is set, as with any phase vocoder." ;
    trn:caution "Lifter must sit below the shortest pitch period in the input, or harmonics leak into the formant envelope and move with it." ;
    trn:caution "MIDI control changes 70 to 80, on any channel, drive the parameters in the order Formant shift, Formant depth, Formant tilt per octave, Pitch shift, Pitch fine, Frequency shift, Harmonic depth, Lifter, Envelope estimator, Mix, Output. Value 64 is each parameter's default where the default lies inside its range, so a centred controller changes nothing; 64 and above selects the true envelope." ;
    trn:caution "A controller's value is not shown on the panel and is not saved with the project. It holds until the host's own value for that parameter next changes, and then the host's value wins." ;
    trn:format trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 2047 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#formant_shift> , <#formant_depth> , <#formant_tilt> , <#pitch_shift> , <#pitch_fine> , <#freq_shift> , <#harmonic_depth> , <#lifter> , <#estimator> , <#mix> , <#output> .

<#module>
    a jig:Module ;
    jig:location <quefrency.wasm> ;
    jig:mediaType "application/wasm" ;
    jig:abi jig:Abi2 ;
    jig:integrity "sha384-twy166QDgRUW7zfeZk4c1ilBK+S5bVyYloClBSI/YXo15+iZyDkflA298lTO3p+J" .

<#processor>
    a jig:Processor ;
    jig:location <quefrency-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "quefrency" ;
    jig:integrity "sha384-n7x3z5Eqx+F3sp/M5dblsTWGUrJQiurTl+egS+RKmUy3+Li7N+3gcXDhbsyTSOid" .

<#formant_shift>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "formant_shift" ; lv2:name "Formant shift" ;
    lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ;
    jig:paramIndex 0 ;
    units:unit units:semitone12TET .

<#formant_depth>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "formant_depth" ; lv2:name "Formant depth" ;
    lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 200 ;
    jig:paramIndex 1 ;
    units:unit units:pc .

<#formant_tilt>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "formant_tilt" ; lv2:name "Formant tilt per octave" ;
    lv2:default 0 ; lv2:minimum -6 ; lv2:maximum 6 ;
    jig:paramIndex 2 ;
    units:unit units:db .

<#pitch_shift>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_shift" ; lv2:name "Pitch shift" ;
    lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24 ;
    jig:paramIndex 3 ;
    units:unit units:semitone12TET .

<#pitch_fine>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_fine" ; lv2:name "Pitch fine" ;
    lv2:default 0 ; lv2:minimum -100 ; lv2:maximum 100 ;
    jig:paramIndex 4 ;
    units:unit units:cent .

<#freq_shift>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "freq_shift" ; lv2:name "Frequency shift" ;
    lv2:default 0 ; lv2:minimum -1000 ; lv2:maximum 1000 ;
    jig:paramIndex 5 ;
    units:unit units:hz .

<#harmonic_depth>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "harmonic_depth" ; lv2:name "Harmonic depth" ;
    lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 200 ;
    jig:paramIndex 6 ;
    units:unit units:pc .

<#lifter>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "lifter" ; lv2:name "Lifter" ;
    lv2:default 1.5 ; lv2:minimum 0.5 ; lv2:maximum 5 ;
    jig:paramIndex 7 ;
    units:unit units:ms .

<#estimator>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "estimator" ; lv2:name "Envelope estimator" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 8 ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#estimator-0> ,
        <#estimator-1> .

<#estimator-0> rdfs:label "Cepstral" ; rdf:value 0 .

<#estimator-1> rdfs:label "True envelope" ; rdf:value 1 .

<#mix>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mix" ; lv2:name "Mix" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 9 .

<#output>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "output" ; lv2:name "Output" ;
    lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 12 ;
    jig:paramIndex 10 ;
    units:unit units:db .
