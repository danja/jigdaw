{
  "iri": "https://strandz.it/jigdaw/plugins/counterpointer/",
  "label": "Counterpointer",
  "comment": "Transport synced MIDI processor that learns an incoming cycle and answers it with a monophonic counter-melody, in counterpoint or a descending bass register.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "counterpointer",
  "roles": [
    "trn:MidiProcessor"
  ],
  "accepts": [
    "trn:Midi"
  ],
  "produces": [
    "trn:Midi",
    "trn:MelodyMidi"
  ],
  "cautions": [
    "Silent until the transport rolls and a full cycle of incoming MIDI has been captured. A counter-melody with nothing to answer would be guessing, and this one says so by producing nothing.",
    "Pure MIDI, no audio: route its MIDI output to an instrument. Learn is a trigger that fires on the rising edge, so each press is one action.",
    "Monophonic by design. A new step ends the note before it rather than overlapping.",
    "With pass_input on, incoming notes continue downstream alongside the counter-melody, including while stopped or still learning."
  ],
  "format": "trn:Jig , trn:WebAudio",
  "licenceId": "Apache-2.0",
  "abi": "jig:Abi2",
  "requires": [
    "jig:MidiEvents",
    "jig:MidiOut",
    "trn:HostTransport"
  ],
  "prefers": [],
  "shape": {
    "stateless": true,
    "audioInputs": 0,
    "audioOutputs": 0,
    "renderQuantum": 128,
    "latencyFrames": 0
  },
  "resources": {
    "module": "counterpointer.wasm",
    "processor": "counterpointer-processor.js"
  },
  "ports": [
    { "symbol": "key", "name": "Key", "default": 0, "minimum": 0, "maximum": 11, "paramIndex": 0 },
    {
      "symbol": "scale", "name": "Scale", "default": 3, "minimum": 0, "maximum": 23, "paramIndex": 1,
      "scalePoints": [
        { "label": "Chromatic", "value": 0 }, { "label": "Major", "value": 1 },
        { "label": "Ionian", "value": 2 }, { "label": "Natural Minor", "value": 3 },
        { "label": "Harmonic Minor", "value": 4 }, { "label": "Melodic Minor", "value": 5 },
        { "label": "Dorian", "value": 6 }, { "label": "Phrygian", "value": 7 },
        { "label": "Lydian", "value": 8 }, { "label": "Mixolydian", "value": 9 },
        { "label": "Locrian", "value": 10 }, { "label": "Phrygian Dominant", "value": 11 },
        { "label": "Neo Major", "value": 12 }, { "label": "Neo Minor", "value": 13 },
        { "label": "Pent Major", "value": 14 }, { "label": "Pent Minor", "value": 15 },
        { "label": "Blues", "value": 16 }, { "label": "Whole Tone", "value": 17 },
        { "label": "Altered", "value": 18 }, { "label": "Half Whole Dim", "value": 19 },
        { "label": "Whole Half Dim", "value": 20 }, { "label": "Bebop Dominant", "value": 21 },
        { "label": "Bebop Major", "value": 22 }, { "label": "Bebop Minor", "value": 23 }
      ]
    },
    { "symbol": "cycle_bars", "name": "Cycle Bars", "default": 2, "minimum": 1, "maximum": 8, "paramIndex": 2 },
    {
      "symbol": "granularity", "name": "Granularity", "default": 0, "minimum": 0, "maximum": 2, "paramIndex": 3,
      "scalePoints": [
        { "label": "Beat", "value": 0 }, { "label": "Half Bar", "value": 1 }, { "label": "Bar", "value": 2 }
      ]
    },
    { "symbol": "follow", "name": "Follow", "default": 0.55, "minimum": 0.0, "maximum": 1.0, "paramIndex": 4 },
    { "symbol": "counter", "name": "Counter", "default": 0.55, "minimum": 0.0, "maximum": 1.0, "paramIndex": 5 },
    { "symbol": "short_random", "name": "Short Random", "default": 0.15, "minimum": 0.0, "maximum": 1.0, "paramIndex": 6 },
    { "symbol": "long_random", "name": "Long Random", "default": 0.0, "minimum": 0.0, "maximum": 1.0, "paramIndex": 7 },
    { "symbol": "density", "name": "Density", "default": 0.78, "minimum": 0.0, "maximum": 1.0, "paramIndex": 8 },
    { "symbol": "rhythm_follow", "name": "Rhythm Follow", "default": 0.65, "minimum": 0.0, "maximum": 1.0, "paramIndex": 9 },
    { "symbol": "syncopation", "name": "Syncopation", "default": 0.25, "minimum": 0.0, "maximum": 1.0, "paramIndex": 10 },
    { "symbol": "consonance", "name": "Consonance", "default": 0.75, "minimum": 0.0, "maximum": 1.0, "paramIndex": 11 },
    { "symbol": "color", "name": "Color", "default": 0.0, "minimum": 0.0, "maximum": 1.0, "paramIndex": 12 },
    { "symbol": "embellish", "name": "Embellish", "default": 0.25, "minimum": 0.0, "maximum": 1.0, "paramIndex": 13 },
    { "symbol": "regularity", "name": "Regularity", "default": 0.65, "minimum": 0.0, "maximum": 1.0, "paramIndex": 14 },
    {
      "symbol": "register", "name": "Register", "default": 1, "minimum": 0, "maximum": 2, "paramIndex": 15,
      "scalePoints": [
        { "label": "Low", "value": 0 }, { "label": "Mid", "value": 1 }, { "label": "High", "value": 2 }
      ]
    },
    { "symbol": "span", "name": "Span", "default": 0.55, "minimum": 0.0, "maximum": 1.0, "paramIndex": 16 },
    { "symbol": "gate", "name": "Gate", "default": 0.72, "minimum": 0.10, "maximum": 1.0, "paramIndex": 17 },
    { "symbol": "velocity_follow", "name": "Velocity Follow", "default": 0.65, "minimum": 0.0, "maximum": 1.0, "paramIndex": 18 },
    { "symbol": "pass_input", "name": "Pass Input", "default": 1, "minimum": 0, "maximum": 1, "paramIndex": 19, "toggled": true },
    { "symbol": "output_channel", "name": "Output Channel", "default": 0, "minimum": 0, "maximum": 16, "paramIndex": 20 },
    { "symbol": "freeze", "name": "Freeze", "default": 0, "minimum": 0, "maximum": 1, "paramIndex": 21, "toggled": true },
    { "symbol": "learn", "name": "Learn", "default": 0, "minimum": 0, "maximum": 1, "paramIndex": 22, "toggled": true },
    {
      "symbol": "response_mode", "name": "Response Mode", "default": 0, "minimum": 0, "maximum": 1, "paramIndex": 23,
      "scalePoints": [
        { "label": "Counterpoint", "value": 0 }, { "label": "Bass Descend", "value": 1 }
      ]
    }
  ]
}
