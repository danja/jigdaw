<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Counterpointer" ;
    rdfs:comment "Transport synced MIDI processor that learns an incoming cycle and answers it with a monophonic counter-melody, in counterpoint or a descending bass register." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiProcessor ;
    trn:accepts trn:Midi ;
    trn:produces trn:Midi , trn:MelodyMidi ;
    trn:caution "Silent until the transport rolls and a full cycle of incoming MIDI has been captured. A counter-melody with nothing to answer would be guessing, and this one says so by producing nothing." ;
    trn:caution "Pure MIDI, no audio: route its MIDI output to an instrument. Learn is a trigger that fires on the rising edge, so each press is one action." ;
    trn:caution "Monophonic by design. A new step ends the note before it rather than overlapping." ;
    trn:caution "With pass_input on, incoming notes continue downstream alongside the counter-melody, including while stopped or still learning." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#key> , <#scale> , <#cycle_bars> , <#granularity> , <#follow> , <#counter> , <#short_random> , <#long_random> , <#density> , <#rhythm_follow> , <#syncopation> , <#consonance> , <#color> , <#embellish> , <#regularity> , <#register> , <#span> , <#gate> , <#velocity_follow> , <#pass_input> , <#output_channel> , <#freeze> , <#learn> , <#response_mode> .

