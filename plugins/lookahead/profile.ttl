#
# GENERATED by bin/write-profile.js. Do not edit: the digests are of the
# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/lookahead/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Lookahead" ;
    rdfs:comment "A switchable lookahead delay for time-aligning parallel paths: direct, or held back by 512 frames. Changing position changes the plugin's latency, which the host compensates." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:caution "Changing position changes latency while audio flows. The host recompensates from the reported frame, and the switch itself is audible as a jump: latency.md says a plugin that can pad to its worst case should, and this one exists to exercise the other path." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 512 ;
    jig:stateless true ;

    jig:processor <#processor> ;

    lv2:port <#position> .

<#processor>
    a jig:Processor ;
    jig:location <lookahead-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "lookahead" ;
    jig:integrity "sha384-Ck0ZO3CuMgQmWyZKsnjZh7JNUj94ZG638qLnsrifMjZi0eDdpnZAD9Qqjtwna0tG" .

<#position>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "position" ; lv2:name "Position" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 512 ;
    jig:paramIndex 0 ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#position-0> ,
        <#position-1> .

<#position-0> rdfs:label "Direct" ; rdf:value 0 .

<#position-1> rdfs:label "512 frames" ; rdf:value 512 .
