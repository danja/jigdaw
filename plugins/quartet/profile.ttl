    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "depth" ; lv2:name "FM Depth" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 4 ;
    jig:paramIndex 42 ;
    jig:controlGroup "FM" ;
    rdfs:comment "How far a full-level modulator moves its target, in cycles. More is brighter." ;
    pprops:displayPriority 90 .

<#pitch_env>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_env" ; lv2:name "Pitch Envelope" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 43 ;
    jig:controlGroup "Pitch envelope" ;
    rdfs:comment "Sweeps the pitch of every operator with its own envelope." ;
    lv2:portProperty lv2:toggled .

<#pitch_env_amount>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_env_amount" ; lv2:name "Pitch Envelope Amount" ;
    lv2:default 12 ; lv2:minimum -48 ; lv2:maximum 48 ;
    jig:paramIndex 44 ;
    jig:controlGroup "Pitch envelope" ;
    rdfs:comment "How far the pitch envelope moves the pitch at full." ;
    units:unit units:semitone12TET .

<#pitch_attack>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_attack" ; lv2:name "Pitch Attack" ;
    lv2:default 1 ; lv2:minimum 0.5 ; lv2:maximum 5000 ;
    jig:paramIndex 45 ;
    jig:controlGroup "Pitch envelope" ;
    units:unit units:ms .

<#pitch_decay>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_decay" ; lv2:name "Pitch Decay" ;
    lv2:default 100 ; lv2:minimum 1 ; lv2:maximum 8000 ;
    jig:paramIndex 46 ;
    jig:controlGroup "Pitch envelope" ;
    units:unit units:ms .

<#pitch_sustain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_sustain" ; lv2:name "Pitch Sustain" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 47 ;
    jig:controlGroup "Pitch envelope" .

<#pitch_release>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "pitch_release" ; lv2:name "Pitch Release" ;
    lv2:default 100 ; lv2:minimum 1 ; lv2:maximum 8000 ;
    jig:paramIndex 48 ;
    jig:controlGroup "Pitch envelope" ;
    units:unit units:ms .

<#filter_type>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "filter_type" ; lv2:name "Filter Type" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 4 ;
    jig:paramIndex 49 ;
    jig:controlGroup "Filter" ;
    rdfs:comment "The shape of the one filter every voice passes through." ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#filter_type-0> ,
        <#filter_type-1> ,
        <#filter_type-2> ,
        <#filter_type-3> ,
        <#filter_type-4> .

<#filter_type-0> rdfs:label "Low-pass 12" ; rdf:value 0 .

<#filter_type-1> rdfs:label "Low-pass 24" ; rdf:value 1 .

<#filter_type-2> rdfs:label "High-pass 12" ; rdf:value 2 .

<#filter_type-3> rdfs:label "Band-pass" ; rdf:value 3 .

<#filter_type-4> rdfs:label "Notch" ; rdf:value 4 .

<#cutoff>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "cutoff" ; lv2:name "Cutoff" ;
    lv2:default 2400 ; lv2:minimum 20 ; lv2:maximum 20000 ;
    jig:paramIndex 50 ;
    jig:controlGroup "Filter" ;
    rdfs:comment "Where the filter starts to cut. Lower is darker." ;
    pprops:displayPriority 80 ;
    units:unit units:hz .

<#resonance>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "resonance" ; lv2:name "Resonance" ;
    lv2:default 0.2 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 51 ;
    jig:controlGroup "Filter" ;
    rdfs:comment "A peak at the cutoff." ;
    pprops:displayPriority 70 .

<#key_track>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "key_track" ; lv2:name "Key Track" ;
    lv2:default 0.3 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 52 ;
    jig:controlGroup "Filter" ;
    rdfs:comment "How much the cutoff follows the note, so high notes stay as bright as low ones." .

<#master>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "master" ; lv2:name "Master" ;
    lv2:default 0.6 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 53 ;
    jig:controlGroup "Output" ;
    rdfs:comment "The overall level of the instrument." ;
    pprops:displayPriority 95 .

<#velocity>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "velocity" ; lv2:name "Velocity" ;
    lv2:default 0.7 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 54 ;
    jig:controlGroup "Output" ;
    rdfs:comment "How much a harder key is louder. At 0 every note is at full level." .

<#bend_range>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "bend_range" ; lv2:name "Bend Range" ;
    lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 24 ;
    jig:paramIndex 55 ;
    jig:controlGroup "Output" ;
    rdfs:comment "How far the pitch wheel bends the pitch." ;
    units:unit units:semitone12TET .

<#quality>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "quality" ; lv2:name "Quality" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 56 ;
    jig:controlGroup "Output" ;
    rdfs:comment "2x oversamples the FM and filters it back down: cleaner at high depth, about twice the CPU." ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#quality-0> ,
        <#quality-1> .

<#quality-0> rdfs:label "1x" ; rdf:value 0 .

<#quality-1> rdfs:label "2x" ; rdf:value 1 .

<#play_mode>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "play_mode" ; lv2:name "Play Mode" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 2 ;
    jig:paramIndex 57 ;
    jig:controlGroup "Voicing" ;
    rdfs:comment "Poly plays every note on its own voice. Mono plays the last note. Legato does the same without restarting the envelopes." ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#play_mode-0> ,
        <#play_mode-1> ,
        <#play_mode-2> .

<#play_mode-0> rdfs:label "Poly" ; rdf:value 0 .

<#play_mode-1> rdfs:label "Mono" ; rdf:value 1 .

<#play_mode-2> rdfs:label "Legato" ; rdf:value 2 .

<#glide>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "glide" ; lv2:name "Glide" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2000 ;
    jig:paramIndex 58 ;
    jig:controlGroup "Voicing" ;
    rdfs:comment "Time to slide from the previous note. 0 is off." ;
    units:unit units:ms .
