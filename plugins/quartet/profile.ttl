<#algorithm-0> rdfs:label "1: D > C > B > A" ; rdf:value 0 .

<#algorithm-1> rdfs:label "2: (C + D) > B > A" ; rdf:value 1 .

<#algorithm-2> rdfs:label "3: (B + (D > C)) > A" ; rdf:value 2 .

<#algorithm-3> rdfs:label "4: D > (B + C) > A" ; rdf:value 3 .

<#algorithm-4> rdfs:label "5: (B > A) + (D > C)" ; rdf:value 4 .

<#algorithm-5> rdfs:label "6: (B + C + D) > A" ; rdf:value 5 .

<#algorithm-6> rdfs:label "7: A + B + (D > C)" ; rdf:value 6 .

<#algorithm-7> rdfs:label "8: A + (D > C > B)" ; rdf:value 7 .

<#algorithm-8> rdfs:label "9: A + ((C + D) > B)" ; rdf:value 8 .

<#algorithm-9> rdfs:label "10: D > (A + B + C)" ; rdf:value 9 .

<#algorithm-10> rdfs:label "11: A + B + C + D" ; rdf:value 10 .

