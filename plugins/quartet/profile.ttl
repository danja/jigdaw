<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Quartet" ;
    rdfs:comment "Eight-voice four-operator FM synthesiser with eleven algorithms, band-limited sine, saw and square operators, per-operator envelopes, feedback, optional 2x oversampling, a pitch envelope and a multimode filter. It opens as a mono bass." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:Instrument , trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "FM synthesis" , "Bass" , "Synthesizer" ;
    trn:caution "It opens as a bass: algorithm 1, mono, a 24 dB low-pass at 2.4 kHz. Set Play Mode to Poly for chords." ;
    trn:caution "A ninth note steals the quietest voice rather than being refused." ;
    trn:caution "The panel does not draw the routing or the filter response the VST3 does; the algorithm is named in its choice list instead." ;
    trn:format trn:Jig ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 0 ;
