<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "DrumGen" ;
    rdfs:comment "Transport synced MIDI drum generator. Genre, style mode and resolution shape a seeded pattern that plays in time with the session, with fills on the last bar of the loop and Conductor CC control." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiGenerator ;
    trn:accepts trn:ControlMidi ;
    trn:produces trn:Midi , trn:DrumMidi ;
    trn:genre "Breakbeat" , "Amen" , "Jungle" , "Hip Hop" , "Jazz" , "Rock" , "Dub" , "Fugue" ;
    trn:caution "Silent until the host transport is rolling and reports a tempo and a beat position. A generator with no idea what time it is would be guessing, and this one says so by producing nothing." ;
    trn:caution "Pure MIDI, no audio: route its MIDI output to a drum instrument. New, Mutate and Fill are triggers that fire on the rising edge, so each press is one action." ;
    trn:caution "A held note with no note off is a stuck note, so stopping the transport sounds the ringing notes now rather than leaving them held." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#genre> , <#style_mode> , <#channel> , <#kit_map> , <#bars> , <#resolution> , <#density> , <#variation> , <#fill_amount> , <#seed> , <#kick_amt> , <#backbeat_amt> , <#hat_amt> , <#aux_amt> , <#new> , <#mutate> , <#fill> , <#tom_amt> , <#metal_amt> , <#vary> , <#conductor_ch> .

