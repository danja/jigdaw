{
  "iri": "https://strandz.it/jigdaw/plugins/drumgen/",
  "label": "DrumGen",
  "comment": "Transport synced MIDI drum generator. Genre, style mode and resolution shape a seeded pattern that plays in time with the session, with fills on the last bar of the loop and Conductor CC control.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "drumgen",
  "roles": [
    "trn:MidiGenerator"
  ],
  "accepts": [
    "trn:ControlMidi"
  ],
  "produces": [
    "trn:Midi",
    "trn:DrumMidi"
  ],
  "genres": [
    "Breakbeat",
    "Amen",
    "Jungle",
    "Hip Hop",
    "Jazz",
    "Rock",
    "Dub",
    "Fugue"
  ],
  "cautions": [
    "Silent until the host transport is rolling and reports a tempo and a beat position. A generator with no idea what time it is would be guessing, and this one says so by producing nothing.",
    "Pure MIDI, no audio: route its MIDI output to a drum instrument. New, Mutate and Fill are triggers that fire on the rising edge, so each press is one action.",
    "A held note with no note off is a stuck note, so stopping the transport sounds the ringing notes now rather than leaving them held."
  ],
  "format": "trn:Jig , trn:WebAudio",
  "licenceId": "Apache-2.0",
  "abi": "jig:Abi2",
  "requires": [
    "jig:MidiEvents",
    "jig:MidiOut",
    "trn:HostTransport"
  ],
  "prefers": [],
  "shape": {
    "audioInputs": 0,
    "audioOutputs": 0,
    "renderQuantum": 128,
    "latencyFrames": 0
  },
  "resources": {
    "module": "drumgen.wasm",
    "processor": "drumgen-processor.js"
  },
  "ports": [
    {
