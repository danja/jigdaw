@base <https://strandz.it/jigdaw/plugins/jigeqb/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "JigEQb" ;
    rdfs:comment "Three-band equalizer benchmark with a declarative SVG skin. This variant tests the cost and clarity of a drawn interface without custom JavaScript code behind the controls." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:genre "EQ" ;
    trn:caution "The DSP is shared with JigEQa and JigEQc. The only intentional difference is the SVG skin, which is data and not executable code." ;
    trn:format trn:Jig ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:stateless true ;

    jig:processor <#processor> ;
    jig:skin <#skin> ;
    jig:asset <#skin> , <#skin-artwork> ;

    lv2:port <#enabled> , <#low_gain> , <#mid_gain> , <#high_gain> .

<#processor>
    a jig:Processor ;
    jig:location <jigeqb-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "jigeqb" ;
    jig:integrity "sha384-KHHBY2oN80Zg4kt4/j46r3Asyv847pVn1Cw8DZTJEr4OttSPdSDH+bhkOJXrrp/f" .

<#skin>
    a jig:Skin ;
    jig:location <skin/skin.ttl> ;
    jig:mediaType "text/turtle" ;
    jig:integrity "sha384-r7reumA17ZNRkJLMLKnGF3rytXqv+L42t/V9pY0FIMjd82l4oDim16+snY3K/deo" .

<#skin-artwork>
    a jig:Resource ;
    jig:location <skin/panel.svg> ;
    jig:mediaType "image/svg+xml" ;
    jig:integrity "sha384-iD7k6pMocRZpeRlTyJ9pWnBj0F7nlcIS/hYABX+JMQAR2W2ifPlt47lKTl8wwcf8" .

<#enabled>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "enabled" ; lv2:name "Enabled" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 0 ;
    lv2:portProperty lv2:toggled .

<#low_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "low_gain" ; lv2:name "Low Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 1 ;
    units:unit units:db .

<#mid_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mid_gain" ; lv2:name "Mid Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 2 ;
    units:unit units:db .

<#high_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "high_gain" ; lv2:name "High Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 3 ;
    units:unit units:db .
