<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "DrumKit" ;
    rdfs:comment "Eleven voice synthesised drum instrument. MIDI notes trigger the voices, the master bus adds crush, drive and room, and per-instrument mutes cut voices immediately." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:Instrument , trn:DrumInstrument ;
    trn:accepts trn:Midi , trn:DrumMidi ;
    trn:produces trn:Audio ;
    trn:caution "One-shot voices: note-offs do nothing, and a hit cannot be choked except the open hat, which a closed hat cuts short." ;
    trn:caution "CC 120 and 123 reset every voice and the master bus, like an all-notes-off." ;
    trn:caution "The eleven trig outputs the native wrapper exposes as UI LEDs are not parameters here and have no panel control." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 0 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

