{
  "iri": "https://strandz.it/jigdaw/plugins/monochord/",
  "label": "Monochord",
  "comment": "Eight-voice waveguide string, plucked, bowed or hammered: a delay line closed into a tuned loop with damping, stiffness, a pickup comb and a small body.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "monochord",
  "roles": [
    "trn:Instrument",
    "trn:AudioInstrument"
  ],
  "accepts": [
    "trn:Midi"
  ],
  "produces": [
    "trn:Audio"
  ],
  "genres": [
    "Physical modelling",
    "Acoustic",
    "Experimental"
  ],
  "cautions": [
    "A ninth note steals the quietest voice rather than being refused.",
    "Exciter changes apply to the next note. A note already sounding keeps the exciter it started with.",
    "The bow keeps sounding while the key is held and its level follows the note velocity; Hardness does not affect it.",
    "Stiffness above about 0.7 detunes the upper partials audibly on a low note (partial 6 is +3 cents at 0.5, +20 at 0.7, +62 at 0.9)."
  ],
  "format": "trn:Jig , trn:WebAudio",
  "abi": "jig:Abi2",
  "requires": [
    "jig:MidiEvents"
  ],
  "prefers": [],
  "shape": {
    "audioInputs": 0,
    "audioOutputs": 1,
    "outputChannels": 2,
    "renderQuantum": 128,
    "latencyFrames": 0,
    "tailFrames": 96000
  },
  "resources": {
    "module": "monochord.wasm",
    "processor": "monochord-processor.js"
  },
  "ports": [
    {
