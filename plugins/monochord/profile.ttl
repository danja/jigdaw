<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Monochord" ;
    rdfs:comment "Eight-voice waveguide string, plucked, bowed or hammered: a delay line closed into a tuned loop with damping, stiffness, a pickup comb and a small body." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:Instrument , trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Physical modelling" , "Acoustic" , "Experimental" ;
    trn:caution "A ninth note steals the quietest voice rather than being refused." ;
    trn:caution "Exciter changes apply to the next note. A note already sounding keeps the exciter it started with." ;
    trn:caution "The bow keeps sounding while the key is held and its level follows the note velocity; Hardness does not affect it." ;
    trn:caution "Stiffness above about 0.7 detunes the upper partials audibly on a low note (partial 6 is +3 cents at 0.5, +20 at 0.7, +62 at 0.9)." ;
    trn:format trn:Jig ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 0 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:tailFrames 96000 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#exciter> , <#position> , <#hardness> , <#bow_pressure> , <#decay> , <#damping> , <#stiffness> , <#body_size> , <#body_level> , <#pickup> , <#release> , <#master> , <#velocity> , <#bend_range> .

