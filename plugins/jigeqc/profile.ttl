# jigeqc/profile.ttl
#
# GENERATED by bin/write-profile.js. Do not edit: the digests are of the
# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/jigeqc/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "JigEQc" ;
    rdfs:comment "Three-band equalizer benchmark with an HTML UI. It shares the same DSP path as JigEQa and JigEQb, while measuring the cost of a custom browser-side editor." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:genre "EQ" ;
    trn:caution "The HTML UI is intentionally separate from the DSP. This keeps the comparison honest: the same filters are used in each variant, with only the controls and presentation different." ;
    trn:format trn:Jig ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:stateless true ;

    jig:processor <#processor> ;
    jig:ui <#ui> ;

    lv2:port <#enabled> , <#low_gain> , <#mid_gain> , <#high_gain> .

<#processor>
    a jig:Processor ;
    jig:location <jigeqc-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "jigeqc" ;
    jig:integrity "sha384-8GljZ7X2iM9/rP6KpRk7QBc6pHmreAky3yxFw4s4w9vjtqKHVrCuFX4qLOfnnf1h" .

<#ui>
    a jig:UserInterface ;
    jig:location <ui/index.html> ;
    jig:mediaType "text/html" ;
    jig:integrity "sha384-LXRo+NMDjjLT2ndauySaN2UJYfcawyYUs+LyNtLfCRd2SqhjZhnvkeTVqdcDiXMo" .

<#enabled>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "enabled" ; lv2:name "Enabled" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 0 ;
    lv2:portProperty lv2:toggled .

<#low_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "low_gain" ; lv2:name "Low Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 1 ;
    units:unit units:db .

<#mid_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mid_gain" ; lv2:name "Mid Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 2 ;
    units:unit units:db .

<#high_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "high_gain" ; lv2:name "High Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 3 ;
    units:unit units:db .
