{
  "iri": "https://strandz.it/jigdaw/plugins/jigeqc/",
  "label": "JigEQc",
  "comment": "Three-band equalizer benchmark with an HTML UI. It shares the same DSP path as JigEQa and JigEQb, while measuring the cost of a custom browser-side editor.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "jigeqc",
  "roles": [
    "trn:AudioEffect"
  ],
  "accepts": [
    "trn:Audio"
  ],
  "produces": [
    "trn:Audio"
  ],
  "genres": [
    "EQ"
  ],
  "cautions": [
    "The HTML UI is intentionally separate from the DSP. This keeps the comparison honest: the same filters are used in each variant, with only the controls and presentation different."
  ],
  "format": "trn:Jig",
  "licenceId": "Apache-2.0",
  "requires": [],
  "prefers": [],
  "shape": {
    "audioInputs": 1,
    "inputChannels": 2,
    "audioOutputs": 1,
    "outputChannels": 2,
    "renderQuantum": 128,
    "latencyFrames": 0,
    "stateless": true
  },
  "resources": {
    "processor": "jigeqc-processor.js",
    "ui": "ui/index.html"
  },
  "ports": [
    {
      "symbol": "enabled",
      "name": "Enabled",
      "default": 1,
      "minimum": 0,
      "maximum": 1,
      "toggled": true,
      "paramIndex": 0
    },
    {
      "symbol": "low_gain",
      "name": "Low Gain",
      "default": 0,
      "minimum": -18,
      "maximum": 18,
      "unit": "db",
      "paramIndex": 1
    },
    {
      "symbol": "mid_gain",
      "name": "Mid Gain",
      "default": 0,
      "minimum": -18,
      "maximum": 18,
      "unit": "db",
      "paramIndex": 2
    },
    {
      "symbol": "high_gain",
      "name": "High Gain",
      "default": 0,
      "minimum": -18,
      "maximum": 18,
      "unit": "db",
      "paramIndex": 3
    }
  ]
}
