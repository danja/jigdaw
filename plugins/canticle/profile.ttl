<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Canticle" ;
    rdfs:comment "Twelve-voice polyphonic tonal instrument for the middle of an ensemble: keys, reed, pad, pluck and glass tones for melody, counterpoint and chords." ;
