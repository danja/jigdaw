<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Mop" ;
    rdfs:comment "Eighteen voice OPL3 FM General MIDI instrument, capped at eight voices by default, based on mop by M. Glargaard. The AdLib Sound Blaster sound of DOS-era games: FM timbres from mop's own bank, a drum kit on channel 10, and every control answering to a MIDI CC." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:Instrument , trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Electronic" , "Chiptune" , "Soundtrack" ;
    trn:caution "Eight voices by default out of the eighteen the chip has. A ninth note steals the oldest voice rather than being refused; raise Voices toward eighteen for dense arrangements." ;
    trn:caution "Percussion is MIDI channel 10, notes 35 to 81. Pitched notes play on any other channel." ;
    trn:caution "The Program control sets the instrument on every melodic channel at once, which is how presets are auditioned. An incoming program change overrides a single channel without moving the panel." ;
    trn:caution "Every control but Program answers to a MIDI CC as well, one controller per port as the profile's midi:binding declarations say. A host automating a parameter and a controller sending its CC will fight." ;
    trn:caution "Channel volume, expression, pan, sustain and pitch bend arrive as MIDI on each channel and are not panel controls: CC 7, 11, 10 and 64 behave as mop does." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Zlib" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 0 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:tailFrames 96000 ;
    jig:stateless true ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#program> , <#voices> , <#gain> , <#bend_range> , <#tuning> , <#vel_sense> .

<#module>
    a jig:Module ;
    jig:location <mop.wasm> ;
    jig:mediaType "application/wasm" ;
    jig:abi jig:Abi2 ;
    jig:integrity "sha384-s+w6yEmpcFLFUe4NCwxXRBQG35uS0sRUrKvMF3tjXMoZiOTRtfPmzCaimxfKcIG8" .

<#processor>
    a jig:Processor ;
    jig:location <mop-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "mop" ;
    jig:integrity "sha384-av/7Yu+ScObVjsU1h2JjOo6fUFD+zazIpRaROGYxIiUJ7JS1Nrh5MwkmEP3Jggcz" .

