<#voices>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "voices" ; lv2:name "Instrument: Voices" ;
    lv2:default 8 ; lv2:minimum 1 ; lv2:maximum 18 ;
    jig:paramIndex 1 ;
    jig:controlGroup "Instrument" ;
    midi:binding <#voices-cc> .

<#voices-cc> a midi:Controller ; midi:controllerNumber 70 .

<#gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "gain" ; lv2:name "Output: Gain" ;
    lv2:default 0.8 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 2 ;
    jig:controlGroup "Output" ;
    midi:binding <#gain-cc> .

<#gain-cc> a midi:Controller ; midi:controllerNumber 71 .

<#bend_range>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "bend_range" ; lv2:name "Pitch: Bend Range" ;
    lv2:default 2 ; lv2:minimum 0 ; lv2:maximum 12 ;
    jig:paramIndex 3 ;
    jig:controlGroup "Pitch" ;
    units:unit units:semitone12TET ;
    midi:binding <#bend_range-cc> .

<#bend_range-cc> a midi:Controller ; midi:controllerNumber 72 .

<#tuning>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "tuning" ; lv2:name "Pitch: Tuning" ;
    lv2:default 0 ; lv2:minimum -100 ; lv2:maximum 100 ;
    jig:paramIndex 4 ;
    jig:controlGroup "Pitch" ;
    midi:binding <#tuning-cc> .

<#tuning-cc> a midi:Controller ; midi:controllerNumber 73 .

<#vel_sense>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "vel_sense" ; lv2:name "Response: Velocity" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 5 ;
    jig:controlGroup "Response" ;
    midi:binding <#vel_sense-cc> .

<#vel_sense-cc> a midi:Controller ; midi:controllerNumber 74 .
