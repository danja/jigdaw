@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Sprout" ;
    rdfs:comment "L-system MIDI generator: a grammar is rewritten for up to 16 generations, read as a turtle, and played as a monophonic, scale-quantised line locked to the host transport, optionally growing by one generation every few bars." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiGenerator ;
    trn:accepts trn:Midi , trn:ControlMidi ;
    trn:produces trn:Midi ;
    trn:caution "Silent until the host transport is rolling and reports a tempo and a beat position. Pure MIDI, no audio: route its MIDI output to an instrument. Ported from the Downspout VST3 of the same name; the status read-outs and the panel are not carried over, and the random draw is the VST3's 64-bit mix." ;
    trn:caution "Monophonic by design. A new note ends the note before it rather than overlapping. An expansion longer than 131,072 symbols is not used; the deepest generation that fits plays instead." ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

    jig:stateless true ;
    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;

    lv2:port <#preset> , <#generations> , <#grow_bars> , <#scale> , <#root> , <#step_size> , <#range> , <#grid> , <#gate> , <#probability> , <#velocity> , <#channel> , <#seed> , <#pitch_source> , <#input_channel> , <#cc_channel> , <#conductor_ch> .

