{
  "iri": "https://strandz.it/jigdaw/plugins/cascade/",
  "label": "Cascade",
  "comment": "Schroeder plate reverb with per-mode scaling, damping inside the feedback loop, and a freeze that holds the tail indefinitely.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "cascade",
  "roles": [
    "trn:AudioEffect"
  ],
  "accepts": [
    "trn:Audio"
  ],
  "produces": [
    "trn:Audio"
  ],
  "genres": [
    "Ambient",
    "Electronic"
  ],
  "cautions": [
    "Freeze holds the tail at unity feedback. Following it with a limiter is wise when several instances are frozen at once."
  ],
  "format": "trn:Jig",
  "licenceId": "Apache-2.0",
  "requires": [],
  "prefers": [],
  "shape": {
    "audioInputs": 1,
    "inputChannels": 2,
    "audioOutputs": 1,
    "outputChannels": 2,
    "renderQuantum": 128,
    "latencyFrames": 0,
    "stateless": true
  },
  "resources": {
    "module": "cascade.wasm",
    "processor": "cascade-processor.js"
  },
  "ports": [
    {
      "symbol": "mix",
      "name": "Mix",
      "default": 0.3,
      "minimum": 0.0,
      "maximum": 1.0,
      "paramIndex": 0
    },
    {
      "symbol": "size",
      "name": "Size",
      "default": 24.0,
      "minimum": 2.0,
      "maximum": 60.0,
      "unit": "ms",
      "paramIndex": 1
    },
    {
      "symbol": "damping",
      "name": "Damping",
      "default": 4200.0,
      "minimum": 200.0,
      "maximum": 18000.0,
      "unit": "hz",
      "paramIndex": 2
    },
    {
      "symbol": "freeze",
      "name": "Freeze",
      "default": 0,
      "minimum": 0,
      "maximum": 1,
      "toggled": true,
      "paramIndex": 3
    },
    {
      "symbol": "mode",
      "name": "Mode",
      "default": 0,
      "minimum": 0,
      "maximum": 2,
      "scalePoints": [
        {
          "label": "Plate",
          "value": 0
        },
        {
          "label": "Hall",
          "value": 1
        },
        {
          "label": "Bloom",
          "value": 2
        }
      ],
      "paramIndex": 4
    }
  ],
  "abi": "jig:Abi1",
  "skin": {
    "file": "skin/skin.ttl",
    "artwork": "skin/panel.svg",
    "controls": [
      {
        "id": "mix",
        "kind": "rotary",
        "port": "mix",
        "element": "mix-knob",
        "pivot": "mix-hub",
        "angleMin": -135,
        "angleMax": 135
      },
      {
        "id": "mix-value",
        "kind": "readout",
        "port": "mix",
        "element": "mix-value"
      },
      {
        "id": "size",
        "kind": "rotary",
        "port": "size",
        "element": "size-knob",
        "pivot": "size-hub",
        "angleMin": -135,
        "angleMax": 135
      },
      {
        "id": "size-value",
        "kind": "readout",
        "port": "size",
        "element": "size-value"
      },
      {
        "id": "damping",
        "kind": "rotary",
        "port": "damping",
        "element": "damping-knob",
        "pivot": "damping-hub",
        "angleMin": -135,
        "angleMax": 135
      },
      {
        "id": "damping-value",
        "kind": "readout",
        "port": "damping",
        "element": "damping-value"
      },
      {
        "id": "freeze",
        "kind": "toggle",
        "port": "freeze",
        "element": "freeze-switch"
      },
      {
        "id": "mode",
        "kind": "selector",
        "port": "mode",
        "element": "mode-steps"
      }
    ]
  }
}
