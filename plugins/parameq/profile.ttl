<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Parameq" ;
    rdfs:comment "Six-band stereo parametric equalizer in C++: peak, low and high shelf, low and high pass, band pass and notch shapes per band, each with its own enable, frequency, gain and Q." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
