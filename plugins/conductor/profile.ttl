<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Conductor" ;
    rdfs:comment "Cuts the transport into bar-aligned sections (intro, development, break, reprise, coda), as an editable form of up to 12 steps or by seeded weighted choice, and at each boundary sends a section note and CCs for scene, density, energy, mutation and reset to whatever listens on its channel. Each section can have its own length limits and its own scene, density, energy and mutation values, and may restart the generators listening to it." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiGenerator ;
    trn:produces trn:Midi , trn:ControlMidi ;
    trn:caution "Silent until the host transport is rolling and reports a tempo and a beat position. Pure MIDI, no audio: route its MIDI output to the plugins that should follow it, and set their Conductor channel to this plugin's MIDI channel (16 by default). Ported from the Downspout VST3 of the same name; its panel and status read-outs are not carried over, and the random draw is the VST3's 64-bit mix." ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

    jig:stateless true ;
    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;
    jig:ui <#ui> ;

    lv2:port <#mode> , <#min_bars> , <#max_bars> , <#intro_weight> , <#develop_weight> , <#break_weight> , <#reprise_weight> , <#coda_weight> , <#base_note> , <#channel> , <#scene_cc> , <#density_cc> , <#energy_cc> , <#mutation_cc> , <#reset_cc> , <#seed> , <#jump_to> , <#form_1> , <#form_2> , <#form_3> , <#form_4> , <#form_5> , <#form_6> , <#form_7> , <#form_8> , <#form_9> , <#form_10> , <#form_11> , <#form_12> , <#intro_min_bars> , <#intro_max_bars> , <#develop_min_bars> , <#develop_max_bars> , <#break_min_bars> , <#break_max_bars> , <#reprise_min_bars> , <#reprise_max_bars> , <#coda_min_bars> , <#coda_max_bars> , <#intro_density> , <#intro_energy> , <#intro_mutation> , <#develop_density> , <#develop_energy> , <#develop_mutation> , <#break_density> , <#break_energy> , <#break_mutation> , <#reprise_density> , <#reprise_energy> , <#reprise_mutation> , <#coda_density> , <#coda_energy> , <#coda_mutation> , <#intro_scene> , <#intro_reset> , <#develop_scene> , <#develop_reset> , <#break_scene> , <#break_reset> , <#reprise_scene> , <#reprise_reset> , <#coda_scene> , <#coda_reset> .

