@base <https://strandz.it/jigdaw/plugins/conductor/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Conductor" ;
    rdfs:comment "Cuts the transport into bar-aligned sections (intro, development, break, reprise, coda), as a fixed form or by seeded weighted choice, and at each boundary sends a section note and CCs for scene, density, energy, mutation and reset to whatever listens on its channel." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiGenerator ;
    trn:produces trn:Midi , trn:ControlMidi ;
    trn:caution "Silent until the host transport is rolling and reports a tempo and a beat position. Pure MIDI, no audio: route its MIDI output to the plugins that should follow it, and set their Conductor channel to this plugin's MIDI channel (16 by default). Ported from the Downspout VST3 of the same name; its panel and status read-outs are not carried over, and the random draw differs, so a seed gives a different form from the VST3's." ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

    jig:stateless true ;
    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;

    lv2:port <#mode> , <#min_bars> , <#max_bars> , <#intro_weight> , <#develop_weight> , <#break_weight> , <#reprise_weight> , <#coda_weight> , <#base_note> , <#channel> , <#scene_cc> , <#density_cc> , <#energy_cc> , <#mutation_cc> , <#reset_cc> , <#seed> , <#jump_to> .

<#processor>
    a jig:Processor ;
    jig:location <conductor-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "conductor" ;
    jig:integrity "sha384-qyzK10m87b5nxTdzwxmOCpFEg5qZlfPDRrobuc2CczBFocxW3taMUpM43EWVh6U8" .

<#mode>
