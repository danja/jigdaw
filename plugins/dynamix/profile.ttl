@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Dynamix" ;
    rdfs:comment "Compressor/expander, limiter and clipper/soft distortion in series. A second stereo input on channels 3 and 4 is an external key: when it is connected, the compressor/expander stage reads its level from that instead of the main signal, for sidechain ducking. When nothing is connected there, the stage detects on the main signal itself." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:genre "Dynamics" , "Mastering" ;
    trn:caution "The limiter has no lookahead: it reacts within a fraction of a millisecond rather than before the transient, so a very sharp attack can still touch the ceiling briefly before the gain catches up. Leave a little headroom below the ceiling for material with hard transients." ;
    trn:caution "The compressor/expander stage links its gain reduction across both channels from a single detected level, so it never shifts the stereo image, but it also means the side chain input's balance between its own two channels, not just its overall level, feeds the detector." ;
    trn:caution "Disconnecting the side chain input mid-session returns the compressor/expander to detecting on the main signal on the next block, not instantly at the sample the cable was pulled." ;
    trn:format trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 2 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#comp_enable> , <#comp_mode> , <#threshold> , <#ratio> , <#attack> , <#release> , <#knee> , <#makeup> , <#limit_enable> , <#ceiling> , <#limit_release> , <#clip_enable> , <#drive> , <#shape> .

<#module>
    a jig:Module ;
    jig:location <dynamix.wasm> ;
    jig:mediaType "application/wasm" ;
    jig:abi jig:Abi1 ;
    jig:integrity "sha384-2UahciePbw9UdX79I6Cqg0FmJcv8rHzUnwtiwf4dZ+qna162GdqIOyt/UNerseoT" .

<#processor>
