# jigeqa/profile.ttl
#
# GENERATED by bin/write-profile.js. Do not edit: the digests are of the
# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/jigeqa/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "JigEQa" ;
    rdfs:comment "Minimal three-band equalizer benchmark with only the generated panel. It serves as the baseline for measuring UI cost without a custom editor." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:genre "EQ" ;
    trn:caution "This is the baseline for the JigEQ ABC suite: the DSP stays the same across the variants and only the interface changes." ;
    trn:format trn:Jig ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:stateless true ;

    jig:processor <#processor> ;

    lv2:port <#enabled> , <#low_gain> , <#mid_gain> , <#high_gain> .

<#processor>
    a jig:Processor ;
    jig:location <jigeqa-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "jigeqa" ;
    jig:integrity "sha384-gBZDNlqTyUVziIxSXNQB0kBX4m5o7de9ooUWiyG+qmtsv9AVav3pBtbO13/VazWY" .

<#enabled>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "enabled" ; lv2:name "Enabled" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 0 ;
    lv2:portProperty lv2:toggled .

<#low_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "low_gain" ; lv2:name "Low Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 1 ;
    units:unit units:db .

<#mid_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "mid_gain" ; lv2:name "Mid Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 2 ;
    units:unit units:db .

<#high_gain>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "high_gain" ; lv2:name "High Gain" ;
    lv2:default 0 ; lv2:minimum -18 ; lv2:maximum 18 ;
    jig:paramIndex 3 ;
    units:unit units:db .
