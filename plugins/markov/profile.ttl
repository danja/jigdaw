@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Markov" ;
    rdfs:comment "Markov-chain melody generator: a random walk over the twelve pitch classes driven by a 12 by 12 transition matrix, filled by one of eight styles or learned from a melodic line on its MIDI input, and played in time with the host transport." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiGenerator ;
    trn:accepts trn:Midi , trn:ControlMidi ;
    trn:produces trn:Midi , trn:MelodyMidi ;
    trn:caution "Silent until the host transport is rolling and reports a tempo and a beat position. Pure MIDI, no audio: route its MIDI output to an instrument. Ported from the Downspout VST3 of the same name; the status read-outs and the panel are not carried over, and the random draw is the VST3's 64-bit mix." ;
    trn:caution "The matrix is set by Style and Randomise, or learned. The VST3's cell-by-cell matrix editor is not carried over. The matrix and what it has learned are the plugin's saved state, so a reopened session plays the same melody." ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;

    lv2:port <#root> , <#scale> , <#low> , <#octaves> , <#order> , <#chaos> , <#grid> , <#gate> , <#density> , <#velocity> , <#channel> , <#seed> , <#phrase_bars> , <#style> , <#randomise> , <#learn> , <#learn_channel> , <#learned_mix> , <#clear_learned> , <#conductor_ch> .

<#processor>
    a jig:Processor ;
    jig:location <markov-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "markov" ;
    jig:integrity "sha384-fjBA4eLkiqPSe8Zeb9afnoY8j/8NmCHiDAs/08Zy12b8vBz16IrnAdlTYIKsk7PK" .

<#root>
