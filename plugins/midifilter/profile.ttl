# midifilter/profile.ttl
#
# GENERATED by bin/write-profile.js. Do not edit: the digests are of the
# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/midifilter/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "MIDI Filter" ;
    rdfs:comment "Steers MIDI between plugins: keeps one channel or all, moves what it keeps to another channel, transposes notes, and passes only the notes inside a range, so two of them split a keyboard between two instruments. A note-off passes only for a note-on that passed, so nothing is left sustaining when a setting changes mid-note." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiProcessor ;
    trn:accepts trn:Midi ;
    trn:produces trn:Midi ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:caution "Only the note range and transpose touch notes. Control changes, pitch bend and other channel messages follow the channel settings alone, and system messages always pass." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;

    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;

    lv2:port <#in_channel> , <#out_channel> , <#transpose> , <#low_note> , <#high_note> .

<#processor>
    a jig:Processor ;
    jig:location <midifilter-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "midifilter" ;
    jig:integrity "sha384-D8MSMCYwMNe3we/lBZIiImm5f82Mwk+KBHfxa0nrjWpchvGrtpKwwLWNsLTxCvo2" .

<#in_channel>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "in_channel" ; lv2:name "Keep channel (0 = all)" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    jig:paramIndex 0 .

<#out_channel>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "out_channel" ; lv2:name "Send on channel (0 = as it came)" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 16 ;
    jig:paramIndex 1 .

<#transpose>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "transpose" ; lv2:name "Transpose (semitones)" ;
    lv2:default 0 ; lv2:minimum -48 ; lv2:maximum 48 ;
    jig:paramIndex 2 .

<#low_note>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "low_note" ; lv2:name "Lowest note" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 127 ;
    jig:paramIndex 3 .

<#high_note>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "high_note" ; lv2:name "Highest note" ;
    lv2:default 127 ; lv2:minimum 0 ; lv2:maximum 127 ;
    jig:paramIndex 4 .
