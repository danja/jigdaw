@base <https://strandz.it/jigdaw/plugins/tremolo/skin/skin.ttl> .
@prefix jig: <http://purl.org/stuff/jigdaw/> .

<>
    jig:artwork <#artwork> ;
    jig:control <#rate> , <#rate-value> , <#depth> , <#depth-value> .

<#artwork>
    a jig:Artwork ;
    jig:location <panel.svg> ;
    jig:mediaType "image/svg+xml" ;
    jig:integrity "sha384-K23Bn1aRNRrjMUgcHxHTCw1FcP7CXBf4L8Got9QZmxSLE0q7z4hcNWiI6oH78Fem" .

<#rate>
    a jig:RotaryControl ;
    jig:boundSymbol "rate" ;
    jig:element "rate-knob" ;
    jig:pivotElement "rate-hub" ;
    jig:angleMin -135 ; jig:angleMax 135 .

<#rate-value>
    a jig:ReadoutControl ;
    jig:boundSymbol "rate" ;
    jig:element "rate-value" .

<#depth>
    a jig:LinearControl ;
    jig:boundSymbol "depth" ;
    jig:element "depth-thumb" ;
    jig:hitElement "depth-hit" ;
    jig:trackElement "depth-slot" .

<#depth-value>
