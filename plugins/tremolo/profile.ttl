# tremolo/profile.ttl
#
# GENERATED by bin/write-profile.js. Do not edit: the digests are of the
# files on disk, and editing them by hand is how a profile comes to describe
# artefacts that no longer exist. Edit profile.json and run ./build.sh.

@base <https://strandz.it/jigdaw/plugins/tremolo/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Tremolo" ;
    rdfs:comment "Amplitude modulation by a sine LFO. Its whole signal path is JavaScript: no WebAssembly module, the worked example for a plugin whose processing does not need one." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio ;
    trn:produces trn:Audio ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;
    jig:ui <#ui> ;

    lv2:port <#rate> , <#depth> .

<#processor>
    a jig:Processor ;
    jig:location <tremolo-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "tremolo" ;
    jig:integrity "sha384-hcwCmhc88dE0bxghzK6h1W9Ok/ifW78f6j1rZmkJDARIqkSnXdCg0E1H5SNEVELS" .

<#ui>
    a jig:UserInterface ;
    jig:location <ui/index.html> ;
    jig:mediaType "text/html" ;
    jig:integrity "sha384-WKR+/GIV1heDtdQ0PEUycNEvKv5G5jv9isoa8gLHlBGmODSpXu6jOzR4FkSU7m0o" .

<#rate>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "rate" ; lv2:name "Rate" ;
    lv2:default 5 ; lv2:minimum 0.1 ; lv2:maximum 20 ;
    jig:paramIndex 0 ;
    units:unit units:hz .

<#depth>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "depth" ; lv2:name "Depth" ;
    lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 1 .
