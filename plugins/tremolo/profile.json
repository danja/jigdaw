{
  "iri": "https://strandz.it/jigdaw/plugins/tremolo/",
  "label": "Tremolo",
  "comment": "Amplitude modulation by a sine LFO. Its whole signal path is JavaScript: no WebAssembly module, the worked example for a plugin whose processing does not need one.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "tremolo",
  "roles": [
    "trn:AudioEffect"
  ],
  "accepts": [
    "trn:Audio"
  ],
  "produces": [
    "trn:Audio"
  ],
  "cautions": [
    "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can."
  ],
  "format": "trn:Jig",
  "licenceId": "Apache-2.0",
  "requires": [],
  "prefers": [],
  "shape": {
    "audioInputs": 1,
    "inputChannels": 2,
    "audioOutputs": 1,
    "outputChannels": 2,
    "renderQuantum": 128,
    "latencyFrames": 0,
    "stateless": true
  },
  "resources": {
    "processor": "tremolo-processor.js",
    "ui": "ui/index.html"
  },
  "ports": [
    {
      "symbol": "rate",
      "name": "Rate",
      "default": 5,
      "minimum": 0.1,
      "maximum": 20,
      "paramIndex": 0,
      "unit": "hz",
      "automationRate": "a-rate"
    },
    {
      "symbol": "depth",
      "name": "Depth",
      "default": 0.5,
      "minimum": 0,
      "maximum": 1,
      "paramIndex": 1
    }
  ],
  "skin": {
    "file": "skin/skin.ttl",
    "artwork": "skin/panel.svg",
    "controls": [
      {
        "id": "rate",
        "kind": "rotary",
        "port": "rate",
        "element": "rate-knob",
        "pivot": "rate-hub",
        "angleMin": -135,
        "angleMax": 135
      },
      {
        "id": "rate-value",
        "kind": "readout",
        "port": "rate",
        "element": "rate-value"
      },
      {
        "id": "depth",
        "kind": "linear",
        "port": "depth",
        "element": "depth-thumb",
        "track": "depth-slot",
        "hit": "depth-hit"
      },
      {
        "id": "depth-value",
        "kind": "readout",
        "port": "depth",
        "element": "depth-value"
      }
    ]
  }
}
