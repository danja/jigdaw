{
  "iri": "https://strandz.it/jigdaw/plugins/octet/",
  "label": "Octet",
  "comment": "Eight-band parametric equalizer, stereo, with 12 and 48 dB cuts, shelves, bells and notches, Left/Right and Mid/Side modes, a spectrum analyser and a graphic editor with a draggable node per band. A fresh instance passes the signal unchanged.",
  "vendor": "danja",
  "developer": "http://danny.ayers.name",
  "version": "1.0.0",
  "registeredName": "octet",
  "roles": [
    "trn:AudioEffect"
  ],
  "accepts": [
    "trn:Audio",
    "trn:MidiCC"
  ],
  "produces": [
    "trn:Audio"
  ],
  "genres": [
    "EQ"
  ],
  "cautions": [
    "The graphic display (the response curves, a node to drag for each band and the spectrum analyser) is the plugin's own editor, offered beside the generated panel where the host can frame it; every control is also on the generated panel.",
    "MIDI controllers 1 to 4 on the CC channel drive one band and the output, as in Drift. The panel does not follow them.",
    "The 48 dB cuts are 8th-order Butterworth; a corner within a few percent of half the sample rate behaves like a gentler slope, because the bilinear transform compresses the top octave."
  ],
  "format": "trn:Jig",
  "abi": "jig:Abi2",
  "requires": [
    "jig:MidiEvents"
  ],
  "prefers": [],
  "shape": {
    "audioInputs": 1,
    "inputChannels": 2,
    "audioOutputs": 1,
    "outputChannels": 2,
    "renderQuantum": 128,
    "latencyFrames": 0,
    "stateless": true
  },
  "resources": {
    "module": "octet.wasm",
    "processor": "octet-processor.js",
    "ui": "ui/index.html"
  },
  "ports": [
    {
      "symbol": "mode",
      "name": "Mode",
      "default": 0,
      "minimum": 0,
      "maximum": 2,
      "group": "Stereo and output",
      "paramIndex": 0,
      "displayPriority": 100,
      "comment": "Stereo treats both channels alike, Left/Right and Mid/Side give each band a channel of its own.",
      "scalePoints": [
        {
          "label": "Stereo",
          "value": 0
        },
        {
          "label": "Left/Right",
          "value": 1
        },
        {
          "label": "Mid/Side",
          "value": 2
        }
