<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Octet" ;
    rdfs:comment "Eight-band parametric equalizer, stereo, with 12 and 48 dB cuts, shelves, bells and notches, Left/Right and Mid/Side modes, a spectrum analyser and a graphic editor with a draggable node per band. A fresh instance passes the signal unchanged." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:AudioEffect ;
    trn:accepts trn:Audio , trn:MidiCC ;
    trn:produces trn:Audio ;
    trn:genre "EQ" ;
    trn:caution "The graphic display (the response curves, a node to drag for each band and the spectrum analyser) is the plugin's own editor. A host shows it only for a plugin served from another origin than its own page; every control is also on the generated panel." ;
    trn:caution "MIDI controllers 1 to 4 on the CC channel drive one band and the output, as in Drift. The panel does not follow them." ;
    trn:caution "The 48 dB cuts are 8th-order Butterworth; a corner within a few percent of half the sample rate behaves like a gentler slope, because the bilinear transform compresses the top octave." ;
    trn:format trn:Jig ;
    pu:licenceId "MIT" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 1 ;
    jig:inputChannels 2 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;
    jig:stateless true ;

    jig:module <#module> ;
    jig:processor <#processor> ;
    jig:ui <#ui> ;

    lv2:port <#mode> , <#output> , <#band1_on> , <#band1_type> , <#band1_freq> , <#band1_gain> , <#band1_q> , <#band1_channel> , <#band2_on> , <#band2_type> , <#band2_freq> , <#band2_gain> , <#band2_q> , <#band2_channel> , <#band3_on> , <#band3_type> , <#band3_freq> , <#band3_gain> , <#band3_q> , <#band3_channel> , <#band4_on> , <#band4_type> , <#band4_freq> , <#band4_gain> , <#band4_q> , <#band4_channel> , <#band5_on> , <#band5_type> , <#band5_freq> , <#band5_gain> , <#band5_q> , <#band5_channel> , <#band6_on> , <#band6_type> , <#band6_freq> , <#band6_gain> , <#band6_q> , <#band6_channel> , <#band7_on> , <#band7_type> , <#band7_freq> , <#band7_gain> , <#band7_q> , <#band7_channel> , <#band8_on> , <#band8_type> , <#band8_freq> , <#band8_gain> , <#band8_q> , <#band8_channel> , <#cc_channel> , <#cc_band> , <#spectrum_source> .

