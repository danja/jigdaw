<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Cadence" ;
    rdfs:comment "Transport synced MIDI harmonizer that learns a chord cycle from what it hears and plays voiced progressions with comping in time with the session." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiProcessor ;
    trn:accepts trn:Midi ;
    trn:produces trn:Midi , trn:HarmonyMidi ;
    trn:caution "Silent until it has learned a cycle: play notes into it while the transport rolls, and it starts harmonizing at the next cycle boundary." ;
    trn:caution "Pure MIDI, no audio: route its MIDI output to an instrument. Learn is a trigger that fires on the rising edge." ;
    trn:caution "With pass_input on, incoming notes continue downstream alongside the harmony." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;
    trn:requires trn:HostTransport ;

