@base <https://strandz.it/jigdaw/plugins/dice/> .

@prefix jig:   <http://purl.org/stuff/jigdaw/> .
@prefix trn:   <http://purl.org/stuff/transmissions/> .
@prefix pu:    <http://purl.org/stuff/plugin-universe/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "Dice" ;
    rdfs:comment "A MIDI probability gate: each note-on passes with the set probability, and a note-off passes if and only if its note-on did. The generator's evolving state is saved with the project, so a restored session gates exactly as the saved one would have." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    doap:developer <http://danny.ayers.name> ;
    foaf:homepage <> ;
    trn:role trn:MidiProcessor ;
    trn:accepts trn:Midi ;
    trn:produces trn:Midi ;
    trn:caution "Declares no jig:module and so no jig:abi. A host that loads a module directly, such as the native adapter, cannot load this plugin; a JavaScript AudioWorklet host can." ;
    trn:caution "A dropped note-on also drops its note-off, so nothing downstream is left sustaining. Anything that is not a note passes through untouched." ;
    trn:format trn:Jig , trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;
    trn:requires jig:MidiOut ;

    jig:audioInputs 0 ;
    jig:audioOutputs 0 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:processor <#processor> ;

    lv2:port <#probability> , <#seed> , <#reseed> .

<#processor>
    a jig:Processor ;
    jig:location <dice-processor.js> ;
    jig:mediaType "text/javascript" ;
    jig:registeredName "dice" ;
    jig:integrity "sha384-rcKeSQ3jH6aKTmaM7w6a0jt50uQ18tbZ5G1G4qdzgTQrntDNFAays/ITw55psawo" .

<#probability>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "probability" ; lv2:name "Probability" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 0 .

<#seed>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "seed" ; lv2:name "Seed" ;
    lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 9999 ;
    jig:paramIndex 1 .

<#reseed>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "reseed" ; lv2:name "Reseed" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 2 ;
    lv2:portProperty lv2:toggled .
