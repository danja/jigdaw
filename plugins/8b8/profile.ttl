    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "temperament" ; lv2:name "Tuning: Temperament" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 9 ;
    jig:paramIndex 39 ;
    jig:controlGroup "Tuning" ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#temperament-0> ,
        <#temperament-1> ,
        <#temperament-2> ,
        <#temperament-3> ,
        <#temperament-4> ,
        <#temperament-5> ,
        <#temperament-6> ,
        <#temperament-7> ,
        <#temperament-8> ,
        <#temperament-9> ;
    midi:binding <#temperament-cc> .

<#temperament-0> rdfs:label "Equal" ; rdf:value 0 .

<#temperament-1> rdfs:label "Meantone" ; rdf:value 1 .

<#temperament-2> rdfs:label "Just" ; rdf:value 2 .

<#temperament-3> rdfs:label "Pythag" ; rdf:value 3 .

<#temperament-4> rdfs:label "Werck III" ; rdf:value 4 .

<#temperament-5> rdfs:label "Kirn III" ; rdf:value 5 .

<#temperament-6> rdfs:label "Vallotti" ; rdf:value 6 .

<#temperament-7> rdfs:label "Young" ; rdf:value 7 .

<#temperament-8> rdfs:label "Kellner" ; rdf:value 8 .

<#temperament-9> rdfs:label "1/6 Mean" ; rdf:value 9 .

<#temperament-cc> a midi:Controller ; midi:controllerNumber 109 .

<#temper_root>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "temper_root" ; lv2:name "Tuning: Root" ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 11 ;
    jig:paramIndex 40 ;
    jig:controlGroup "Tuning" ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint
        <#temper_root-0> ,
        <#temper_root-1> ,
        <#temper_root-2> ,
        <#temper_root-3> ,
        <#temper_root-4> ,
        <#temper_root-5> ,
        <#temper_root-6> ,
        <#temper_root-7> ,
        <#temper_root-8> ,
        <#temper_root-9> ,
        <#temper_root-10> ,
        <#temper_root-11> ;
    midi:binding <#temper_root-cc> .

<#temper_root-0> rdfs:label "C" ; rdf:value 0 .

<#temper_root-1> rdfs:label "C#" ; rdf:value 1 .

<#temper_root-2> rdfs:label "D" ; rdf:value 2 .

<#temper_root-3> rdfs:label "D#" ; rdf:value 3 .

<#temper_root-4> rdfs:label "E" ; rdf:value 4 .

<#temper_root-5> rdfs:label "F" ; rdf:value 5 .

<#temper_root-6> rdfs:label "F#" ; rdf:value 6 .

<#temper_root-7> rdfs:label "G" ; rdf:value 7 .

<#temper_root-8> rdfs:label "G#" ; rdf:value 8 .

<#temper_root-9> rdfs:label "A" ; rdf:value 9 .

<#temper_root-10> rdfs:label "A#" ; rdf:value 10 .

<#temper_root-11> rdfs:label "B" ; rdf:value 11 .

<#temper_root-cc> a midi:Controller ; midi:controllerNumber 110 .

<#vel_sense>
    a lv2:InputPort , lv2:ControlPort ;
    lv2:symbol "vel_sense" ; lv2:name "Pitch & Response: Velocity" ;
    lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ;
    jig:paramIndex 41 ;
    jig:controlGroup "Pitch & Response" ;
    lv2:portProperty lv2:toggled ;
    midi:binding <#vel_sense-cc> .

<#vel_sense-cc> a midi:Controller ; midi:controllerNumber 111 .
