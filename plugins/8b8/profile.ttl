<>
    a jig:WebPlugin , trn:PluginProfile ;
    rdfs:label "8-Bit 8asterd" ;
    rdfs:comment "Three AY-3-8910 chips under the 8b8 firmware, running unmodified as WebAssembly. Nine voices across three chips, hardware envelopes, a percussion set on channel 10, and the firmware's own vibrato, tremolo, arpeggiator, buzzy bass, circuit bending and ten tuning temperaments." ;
    trn:vendor "danja" ;
    doap:revision "1.0.0" ;
    foaf:homepage <> ;
    trn:role trn:Instrument , trn:AudioInstrument ;
    trn:accepts trn:Midi ;
    trn:produces trn:Audio ;
    trn:genre "Chiptune" , "Electronic" ;
    trn:caution "Nine voices across three chips, and the tenth note steals the oldest rather than being refused. Percussion and pitched notes come out of the same nine." ;
    trn:caution "Percussion is MIDI channel 10, notes 35 to 59. Pitched notes are 24 to 96 on any other channel, and anything outside that is ignored rather than transposed into range." ;
    trn:caution "Every control answers to a MIDI CC as well, one controller per port as the profile's midi:binding declarations say, which is what the hardware does. A host automating a parameter and a controller sending its CC will fight." ;
    trn:caution "Roll and Retrigger are positions on an exponential curve from about 1.5Hz to 45Hz rather than a rate in hertz. The figure shown is the one the device's own panel shows." ;
    trn:caution "The firmware's EEPROM is a scratch array that is never persisted. Its SAVE command has nowhere to write, and settings belong in the project graph instead." ;
    trn:format trn:WebAudio ;
    pu:licenceId "Apache-2.0" ;
    trn:requires jig:MidiEvents ;

    jig:audioInputs 0 ;
    jig:audioOutputs 1 ;
    jig:outputChannels 2 ;
    jig:renderQuantum 128 ;
    jig:latencyFrames 0 ;

    jig:module <#module> ;
    jig:processor <#processor> ;

    lv2:port <#buzz_enable> , <#buzz_ratio> , <#buzz_shape> , <#buzz_detune> , <#warp_mode> , <#warp_rate> , <#warp_depth> , <#warp_motion> , <#vib_enable> , <#vib_rate> , <#vib_depth> , <#vib_delay> , <#trem_enable> , <#trem_rate> , <#trem_depth> , <#noise_enable> , <#noise_period> , <#drum_tune> , <#drum_decay> , <#drum_bend> , <#drum_noise> , <#drum_roll> , <#drum_flam> , <#drum_reverse> , <#drum_chaos> , <#arp_mode> , <#arp_rate> , <#sweep_amount> , <#retrig_rate> , <#env_mode> , <#env_attack> , <#env_decay> , <#env_sustain> , <#env_release> , <#glide> , <#transpose> , <#mix_noise> , <#mix_tone> , <#mix_drum> , <#temperament> , <#temper_root> , <#vel_sense> .

